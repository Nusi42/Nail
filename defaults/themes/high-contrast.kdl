// Nail built-in theme: High contrast.
//
// Pure black and white with yellow and cyan accents, thick focus rings,
// visible borders on every control, larger text and no animations. It is
// always in high-contrast mode, whatever Windows is set to. Pick it in
// Settings → Appearance; with "Follow Windows" on, Nail switches to it by
// itself while a Windows contrast theme is active.
//
// Every text passes WCAG AAA (7:1) on every surface; the contrast test
// (crates/nail-config/tests/theme_contrast.rs) checks each pair. The
// selection is a solid highlight: everything inside a selected item uses
// `selection-fg`. See userDocs/en/accessibility.md.

theme "High contrast" extends="default" mode="high-contrast" {
    tokens {
        // Surfaces. `print=` is the print view (white paper, black text).
        color "bg"            "#000000" print="#ffffff"
        color "bg-subtle"     "#000000" print="#ffffff"
        color "bg-raised"     "#141414" print="#ffffff"
        color "canvas"        "#000000" print="#ffffff"
        color "rail"          "#000000" print="#ffffff"

        // Text: the same white for every level, so nothing looks washed out.
        color "fg"            "#ffffff" print="#000000"
        color "fg-muted"      "#ffffff" print="#000000"
        color "fg-subtle"     "#ffffff" print="#000000"

        // Lines.
        color "border"        "#ffffff" print="#000000"
        color "border-strong" "#ffffff" print="#000000"

        // Accent and selection.
        color "accent"        "#ffff00" print="#000000"
        color "accent-fg"     "#000000" print="#ffffff"
        color "accent-soft"   "#333300" print="#ffffff"
        color "selection"     "#ffff00" print="#000000"
        color "selection-fg"  "#000000" print="#ffffff"
        color "unread"        "$color.accent"
        color "focus-ring"    "#00ffff" print="#000000"

        // States.
        color "danger"        "#ff8080" print="#000000"
        color "flagged"       "$color.danger"
        color "warning"       "#ffff00" print="#000000"
        color "success"       "#80ff80" print="#000000"
        color "quote-1"       "#ffff00" print="#000000"
        color "quote-2"       "#80ff80" print="#000000"
        color "quote-3"       "#00ffff" print="#000000"
        color "scrim"         "rgb(0 0 0 / 0.85)"

        // One step larger text (the whole type scale follows `body`).
        font-size "body" 16 compact=15

        border "thin"    "2px solid $color.border"
        border "control" "2px solid $color.border-strong"
        shadow "raised"  "none"
        shadow "overlay" "0 0 0 2px $color.border"
        shadow "window"  "0 0 0 2px $color.border"

        // No motion at all.
        motion "fast"   "0ms"
        motion "normal" "0ms"
    }

    // Focus is always clearly visible: a thick cyan ring with a gap.
    part "toolbar.button:focus-visible" {
        outline "3px solid $color.focus-ring"
        outline-offset 2
    }
    part "form.button:focus-visible" {
        outline "3px solid $color.focus-ring"
        outline-offset 2
    }
    part "form.input:focus-visible" { outline "3px solid $color.focus-ring"; }
    part "message-list.row:focus-visible" { outline "3px solid $color.focus-ring"; }
    part "folder-tree.item:focus-visible" { outline "3px solid $color.focus-ring"; }
    part "context-menu.item:focus-visible" {
        outline "3px solid $color.focus-ring"
        outline-offset -3
    }

    // Controls are outlined, not only coloured.
    part "toolbar.button" { border "$border.thin"; }
    part "tabs.tab" { border "$border.thin"; }
    part "tabs.tab:selected" { text-decoration "underline"; }

    // Selection and unread mail are told apart by more than colour.
    part "message-list.row:selected" { outline "2px solid $color.selection"; }
    // Every row keeps a 6px left edge (so read and unread text lines up);
    // unread rows fill it with the accent.
    part "message-list.row" { border-left "6px solid transparent"; }
    part "message-list.row:unread" { border-left-color "$color.accent"; }
    part "message-list.row:flagged" { text-decoration "underline"; }
    // Inside a selected item everything takes the highlight's text colour
    // (the light / dark themes keep accent icons and counts there).
    part "folder-tree.item:selected .icon" { color "inherit"; }
    part "folder-tree.item:selected .unread-count" { color "inherit"; }
    part "message-list.row:selected .unread-dot" { background-color "$color.selection-fg"; }
    // Avatars and file-type badges are white with black text here; on the
    // white-ish highlight a black ring keeps their shape.
    part "message-list.row:selected .avatar" { box-shadow "inset 0 0 0 2px $color.selection-fg"; }
    part "message-list:focus-visible" {
        outline "3px solid $color.focus-ring"
        outline-offset -3
    }

    // Hover is a visible fill, not a near-black shade of black.
    part "message-list.row:hover" { background-color "$color.accent-soft"; }
    part "folder-tree.item:hover" { background-color "$color.accent-soft"; }
    part "context-menu.item:hover" { background-color "$color.accent-soft"; }
    part "toolbar.button:hover" { background-color "$color.accent-soft"; }
    part "account-switcher.item:hover" { background-color "$color.accent-soft"; }
    part "context-menu.item:focus" { background-color "$color.accent-soft"; }
    // A selected item keeps its solid highlight under the pointer.
    part "message-list.row:selected:hover" { background-color "$color.selection"; }
    part "folder-tree.item:selected:hover" { background-color "$color.selection"; }
    part "account-switcher.item:selected:hover" { background-color "$color.selection"; }
    // Check boxes get the same 2px outline as every other control.
    part "form.checkbox" {
        outline "$border.control"
        outline-offset 1
    }
    part "form.checkbox:focus-visible" { outline "3px solid $color.focus-ring"; }

    // Dividers are easy to see and to grab.
    part "split.divider" { background-color "$color.border"; }

    // Invitations and free/busy: states differ by more than colour.
    part "invitation" { border "$border.thin"; border-left-width 6; }
    part "invitation.issue[severity=\"danger\"]" { text-decoration "underline"; }
    part "freebusy.busy" { border "2px solid $color.border"; }
    part "freebusy.meeting" { border "3px dashed $color.focus-ring"; }
    part "label-list.view:focus-visible" { outline "3px solid $color.focus-ring"; }
    part "category-tabs.tab" { border "$border.thin"; }
    part "category-tabs.tab:selected" { text-decoration "underline"; }
}

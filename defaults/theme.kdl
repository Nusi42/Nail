    part "gmail.color:selected" { border "1px solid $color.accent"; }
    part "gmail.color.sample" { display "inline-block"; padding 0 "$space.xs"; border-radius "$radius.sm"; }
    part "gmail.color.name" { font-size "$font-size.sm"; }
    part "gmail.dialog" { display "flex"; flex-direction "column"; gap "$space.md"; min-width 360; max-width 640; padding "$space.md"; }

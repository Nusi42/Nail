    part "label-list.name" { flex "1"; overflow "hidden"; text-overflow "ellipsis"; white-space "nowrap"; }
    part "label-list.unread" { font-size "$font-size.xs"; font-weight "$font-weight.bold"; color "$color.unread"; }
    part "label-list.pending" { font-size "$font-size.xs"; color "$color.warning"; }
    part "label-list.edit" { border 0; padding "$space.xxs"; color "$color.fg-muted"; background-color "transparent"; cursor "pointer"; }
    part "label-list.delete" { border 0; padding "$space.xxs"; color "$color.fg-muted"; background-color "transparent"; cursor "pointer"; }
    part "label-list.empty" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "label-list.error" { margin 0; font-size "$font-size.sm"; color "$color.danger"; }
    part "category-tabs" { padding 0 "$space.sm"; border-bottom "$border.thin"; }
    part "category-tabs.list" { gap "$space.xxs"; }
    part "category-tabs.tab" { display "flex"; align-items "center"; gap "$space.xs"; border 0; border-bottom "2px solid transparent"; padding "$space.xs" "$space.sm"; color "$color.fg-muted"; background-color "transparent"; cursor "pointer"; }

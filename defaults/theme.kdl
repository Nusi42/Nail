    part "freebusy.error" { font-size "$font-size.xs"; color "$color.danger"; }
    part "freebusy.track" { min-height 24; border "$border.thin"; border-radius "$radius.sm"; background-color "$color.bg"; }
    part "freebusy.busy" { border-radius "$radius.sm"; background-color "$color.accent"; }
    part "freebusy.busy[kind=\"tentative\"]" { border "1px dashed $color.accent"; background-color "$color.selection"; }
    part "freebusy.busy[kind=\"unavailable\"]" { background-color "$color.fg-muted"; }
    part "freebusy.meeting" { border "2px solid $color.danger"; border-radius "$radius.sm"; }
    part "freebusy.verdict" { margin 0; font-size "$font-size.sm"; color "$color.success"; }
    part "freebusy.verdict:busy" { color "$color.warning"; }
    part "freebusy.empty" { margin 0; color "$color.fg-muted"; }
    part "freebusy.suggestions" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "freebusy.suggestions.title" { margin 0; font-size "$font-size.sm"; font-weight "$font-weight.medium"; }

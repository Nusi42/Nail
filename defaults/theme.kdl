// Nail default theme.
//
// This file is the complete default look of Nail. Your own theme.kdl can
// start with `theme "My theme" extends="default" { ... }` and override only
// what you want to change. See userDocs/en/theme-reference.md.

theme "default" mode="system" {
    tokens {
        // Colours: the first value is the light (base) value; `dark=` and
        // `high-contrast=` override it in those modes; `print=` applies while
        // the print view is shown (white paper, black text, no shadows).
        // The built-in themes (defaults/themes/*.kdl) replace these colours.
        // Every theme passes the contrast check in
        // crates/nail-config/tests/theme_contrast.rs (WCAG AA; AAA for high
        // contrast).
        //
        // Surfaces: `bg` for panes (list, reader, dialogs), `bg-subtle` for
        // side panes, inputs and hovered rows, `bg-raised` for hovered
        // controls and tags, `canvas` for the window behind the panes,
        // `rail` for the navigation rail.
        color "bg"            "#ffffff" dark="#1b1e24" high-contrast="#000000" print="#ffffff"
        color "bg-subtle"     "#f5f6f8" dark="#22262d" high-contrast="#000000" print="#ffffff"
        color "bg-raised"     "#e9ebef" dark="#2c313a" high-contrast="#141414" print="#ffffff"
        color "canvas"        "#eff1f5" dark="#15181d" high-contrast="#000000" print="#ffffff"
        color "rail"          "#e9ecf1" dark="#17191e" high-contrast="#000000" print="#ffffff"
        // Text: primary, secondary (previews, labels) and tertiary (dates,
        // hints, section labels). All three are readable text (AA).
        color "fg"            "#1d2129" dark="#e3e6eb" high-contrast="#ffffff" print="#000000"
        color "fg-muted"      "#5c6370" dark="#9aa2ae" high-contrast="#ffffff" print="#444444"
        color "fg-subtle"     "#5f6672" dark="#959dab" high-contrast="#ffffff" print="#555555"
        // Lines: `border` separates (dividers, cards); `border-strong`
        // outlines controls such as inputs and selects (3:1 against every
        // surface, so a field is recognisable).
        color "border"        "#d8dce3" dark="#353b45" high-contrast="#ffffff" print="#999999"
        color "border-strong" "#80868f" dark="#787f8b" high-contrast="#ffffff" print="#767676"
        // The accent and what derives from it: the accent override (a
        // `color "accent"` line in your theme.kdl) restyles them all alike.
        color "accent"        "#2e5eaa" dark="#7aa7e8" high-contrast="#ffff00"
        color "accent-fg"     "#ffffff" dark="#10233f" high-contrast="#000000"
        color "accent-soft"   "color-mix(in srgb, $color.accent 12%, $color.bg)" dark="color-mix(in srgb, $color.accent 18%, $color.bg)" high-contrast="#333300"
        color "selection"     "color-mix(in srgb, $color.accent 16%, $color.bg)" high-contrast="#ffff00"
        color "selection-fg"  "#10233f" dark="#eef3fb" high-contrast="#000000"
        color "unread"        "$color.accent"
        color "focus-ring"    "$color.accent" high-contrast="#00ffff"
        // States.
        color "danger"        "#b92b28" dark="#f58a86" high-contrast="#ff8080"
        color "flagged"       "$color.danger"
        color "warning"       "#8a5a00" dark="#e0b050" high-contrast="#ffff00"
        color "success"       "#286b44" dark="#6cc38f" high-contrast="#80ff80"
        color "quote-1"       "#2e5eaa" dark="#7aa7e8"
        color "quote-2"       "#3b8a5a" dark="#7cc49a"
        color "quote-3"       "#8a6d3b" dark="#d2b074"
        // Avatar initials / account dots and file-type badges (white text on
        // every one meets WCAG AA, black in High contrast; the UI picks an
        // avatar colour per address).
        color "avatar-fg"     "#ffffff"
        color "avatar-1"      "#3b5bdb" high-contrast="#000000"
        color "avatar-2"      "#0b7285" high-contrast="#000000"
        color "avatar-3"      "#2f7d3a" high-contrast="#000000"
        color "avatar-4"      "#a61e4d" high-contrast="#000000"
        color "avatar-5"      "#7048e8" high-contrast="#000000"
        color "avatar-6"      "#c2410c" high-contrast="#000000"
        color "avatar-7"      "#5c5f66" high-contrast="#000000"
        color "avatar-8"      "#1864ab" high-contrast="#000000"
        color "file-pdf"      "#c92a2a" high-contrast="#000000"
        color "file-image"    "#0b7285" high-contrast="#000000"
        color "file-document" "#1864ab" high-contrast="#000000"
        color "file-spreadsheet" "#2f7d3a" high-contrast="#000000"
        color "file-archive"  "#7048e8" high-contrast="#000000"
        color "file-calendar" "#c2410c" high-contrast="#000000"
        color "file-other"    "#5c5f66" high-contrast="#000000"
        color "scrim"         "rgb(0 0 0 / 0.35)" dark="rgb(0 0 0 / 0.6)" high-contrast="rgb(0 0 0 / 0.8)"

        // Segoe UI Variable, the Windows 11 face, with the system stack as
        // the fallback. The reader uses the UI face for plain text, too;
        // monospace is for code (and when you pick it).
        font "ui"      #""Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif"#
        font "display" #""Segoe UI Variable Display", "Segoe UI", system-ui, sans-serif"#
        font "reader"  #""Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif"#
        font "mono"    #""Cascadia Mono", Consolas, ui-monospace, monospace"#

        // Unitless numbers are pixels for font-size, space, size and radius.
        //
        // The type scale. Every step is relative to `body`, so changing the
        // text size (Settings → Appearance, or `font-size "body" 15` in your
        // theme.kdl) scales the whole scale; `compact=` is the Compact
        // density. At body 14: label 11.5 (semibold, caps), small 12.5,
        // heading 16 (semibold), title 20 (semibold; 18 in Compact, where
        // body is 13).
        font-size "body"    14 compact=13
        font-size "label"   "calc($font-size.body * 11.5 / 14)"
        font-size "small"   "calc($font-size.body * 12.5 / 14)"
        font-size "heading" "calc($font-size.body * 16 / 14)"
        font-size "title"   "calc($font-size.body * 20 / 14)" compact="calc($font-size.body * 18 / 13)"
        // The pre-M5 names, kept for existing themes: aliases of the scale.
        font-size "xs" "$font-size.label"
        font-size "sm" "$font-size.small"
        font-size "md" "$font-size.body"
        font-size "lg" "$font-size.heading"
        font-size "xl" "$font-size.title"

        font-weight "regular" 400
        font-weight "medium"  500
        font-weight "semibold" 600
        font-weight "bold"    650

        line-height "tight"  1.25
        line-height "normal" 1.45
        line-height "relaxed" 1.65

        // Spacing on a 4 px grid (`xxs` is the half step for hairline gaps).
        space "xxs" 2
        space "xs"  4
        space "sm"  8
        space "md"  12
        space "lg"  16
        space "xl"  24
        space "xxl" 32
        // Semantic spacings: pane padding (the same in every pane, so edges
        // line up), gaps between controls, gaps between sections, and the
        // vertical padding of list rows.
        space "pane"    16 compact=12
        space "gap"     8
        space "section" 24
        space "row"     12 compact=8

        size "icon"         16
        size "touch-target" 48
        size "toolbar"      40
        size "divider"      1
        size "divider-grab" 5
        size "control"      32 compact=28
        size "avatar"       34 compact=28

        // Corners: small for inputs and menu items, medium for buttons and
        // cards, large for windows. `sm` and `lg` follow `md`, so changing
        // the corner radius (`radius "md" 8`) rounds everything alike.
        radius "md"   10
        radius "sm"   "calc($radius.md * 0.6)"
        radius "lg"   "calc($radius.md * 1.4)"
        radius "pill" 999

        border "thin"    "1px solid $color.border"
        border "control" "1px solid $color.border-strong"

        // Elevation: only floating things get a shadow. `raised` for
        // popovers and floating cards, `overlay` for menus, `window` for
        // dialogs and tool windows.
        shadow "raised"  "0 1px 2px rgb(23 32 43 / 0.08), 0 4px 12px rgb(23 32 43 / 0.08)" dark="0 1px 2px rgb(0 0 0 / 0.4), 0 4px 12px rgb(0 0 0 / 0.35)" print="none"
        shadow "overlay" "0 10px 30px rgb(23 32 43 / 0.14)" dark="0 12px 36px rgb(0 0 0 / 0.5)" print="none"
        shadow "window"  "0 16px 48px rgb(23 32 43 / 0.18)" dark="0 16px 48px rgb(0 0 0 / 0.55)" print="none"

        motion "fast"   "100ms"
        motion "normal" "200ms"
        motion "ease"   "cubic-bezier(0.2, 0, 0, 1)"

        opacity "disabled" 0.45
        opacity "muted"    0.7
    }

    // ---- Application frame and containers ----

    part "app" {
        font-family "$font.ui"
        font-size "$font-size.md"
        line-height "$line-height.tight"
        color "$color.fg"
        background-color "$color.bg"
    }

    // A 5px grab area with a 1px line (at the edge of the pane before it).
    part "split.divider" {
        flex-basis "$size.divider-grab"
        border-top "$size.divider solid $color.border"
        background-color "transparent"
        transition "background-color $motion.fast $motion.ease"
    }
    part "split[orientation=\"horizontal\"] split.divider" {
        border-top "none"
        border-left "$size.divider solid $color.border"
    }
    part "split.divider:hover" { background-color "$color.accent"; }
    part "split.divider:focus-visible" { background-color "$color.focus-ring"; }


    // ---- Toolbar and status bar ----

    part "toolbar.spacer" { flex-grow 1; }


    // ---- Accounts and folders ----



    // ---- Message list ----

    // Selected rows: secondary text takes the selection colour for contrast.

    // ---- Message view ----

    part "message-view.empty" {
        margin "auto"
        color "$color.fg-muted"
    }

    // ---- Simple widgets ----

    part "text" { padding "$space.xs" "$space.sm"; }
    part "spacer" { flex-grow 1; }

    // ---- Search ----

    part "search-bar.clear" {
        display "inline-flex"
        padding "$space.xxs"
        border "none"
        border-radius "$radius.sm"
        color "$color.fg-muted"
        background-color "transparent"
    }
    part "search-bar.clear:hover" { background-color "$color.bg-raised"; }
    part "search-bar.clear.icon" {
        width "$size.icon"
        height "$size.icon"
    }
    part "search-bar.error" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        font-size "$font-size.sm"
        color "$color.danger"
    }
    part "search-bar.error.query" {
        font-family "$font.mono"
        color "$color.fg"
    }
    part "search-bar.error.mark" {
        padding 0 1
        border-bottom "2px solid $color.danger"
        color "$color.fg"
        background-color "transparent"
    }
    part "search-bar.hints" {
        display "flex"
        flex-direction "column"
        border "$border.thin"
        border-radius "$radius.md"
        background-color "$color.bg"
        box-shadow "$shadow.raised"
        overflow "hidden"
    }
    part "search-bar.hint.button" {
        display "flex"
        gap "$space.sm"
        width "100%"
        padding "$space.xs" "$space.sm"
        border "none"
        text-align "left"
        color "$color.fg"
        background-color "transparent"
    }
    part "search-bar.hint.button:hover" { background-color "$color.bg-raised"; }
    part "search-bar.hint.syntax" {
        font-family "$font.mono"
        color "$color.accent"
    }
    part "search-bar.hint.description" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "search-bar.hint:info" { padding "$space.xs" "$space.sm"; }
    part "message-list.search-summary" {
        padding "$space.xs" "$space.md"
        font-size "$font-size.sm"
        color "$color.fg-muted"
        border-bottom "$border.thin"
        background-color "$color.bg-subtle"
    }

    // ---- Accounts: status indicators ----

    part "account-switcher.item.name" { flex-grow 1; }
    part "account-switcher.item.status" {
        width 8
        height 8
        border-radius "50%"
        background-color "$color.fg-muted"
    }
    part "account-switcher.item.status:online" { background-color "$color.success"; }
    part "account-switcher.item.status:connecting" { background-color "$color.warning"; }
    part "account-switcher.item.status:auth-error" { background-color "$color.danger"; }
    part "status-bar.item:auth-error" { color "$color.danger"; }
    part "status-bar.item:error" { color "$color.danger"; }
    part "status-bar.item:failed" { color "$color.danger"; }
    part "status-bar.button" {
        margin-left "$space.sm"
        padding 0 "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "status-bar.button:hover" { background-color "$color.bg-raised"; }

    // ---- Thread view ----

    part "thread-view" {
        max-height "40vh"
        overflow-y "auto"
        border-bottom "$border.thin"
        background-color "$color.bg-subtle"
    }
    part "thread-view.header" {
        display "flex"
        gap "$space.sm"
        align-items "baseline"
        padding "$space.xs" "$space.lg"
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "thread-view.subject" {
        flex-grow 1
        font-weight "$font-weight.medium"
        color "$color.fg"
    }
    part "thread-view.item" { border-top "$border.thin"; }
    part "thread-view.item:selected" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    part "thread-view.item.header" {
        display "flex"
        align-items "center"
        gap "$space.sm"
        padding-right "$space.lg"
    }
    part "thread-view.item.toggle" {
        display "flex"
        flex-grow 1
        gap "$space.sm"
        min-width 0
        padding "$space.xs" "$space.lg"
        border "none"
        text-align "left"
        color "inherit"
        background-color "transparent"
        white-space "nowrap"
        overflow "hidden"
    }
    part "thread-view.item.toggle:focus-visible" {
        outline "2px solid $color.focus-ring"
        outline-offset -2
    }
    part "thread-view.item:unread .from" { font-weight "$font-weight.bold"; }
    part "thread-view.item.date" { font-size "$font-size.sm"; }
    part "thread-view.item.preview" {
        overflow "hidden"
        text-overflow "ellipsis"
        font-size "$font-size.sm"
    }
    part "thread-view.item.open" {
        padding 0 "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
        font-size "$font-size.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "thread-view.item.open:disabled" { opacity "$opacity.disabled"; }
    part "thread-view.text" { padding "$space.xs" "$space.lg" "$space.sm"; }
    part "thread-view.body" { font-family "$font.reader"; }
    part "thread-view.quote" {
        padding-left "$space.sm"
        border-left "3px solid $color.quote-1"
        color "$color.fg-muted"
    }
    part "thread-view.quote-toggle" {
        font-size "$font-size.sm"
        color "$color.accent"
        cursor "pointer"
    }

    // ---- Windows (composer, settings, account setup, outbox, move) ----

    part "window" {
        width "min(960px, 100%)"
        height "min(760px, 100%)"
    }
    part "window[window=\"move\"]" {
        width "min(420px, 100%)"
        height "min(560px, 100%)"
    }
    part "window[window=\"account-setup\"]" { width "min(640px, 100%)"; }
    part "window[window=\"outbox\"]" { width "min(720px, 100%)"; }

    // ---- Forms (account setup, settings, virtual accounts, composer, outbox) ----


    part "account-setup" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.lg"
        overflow-y "auto"
    }
    part "account-setup.steps" {
        display "flex"
        gap "$space.md"
        margin 0
        padding 0
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "account-setup.step:selected" {
        font-weight "$font-weight.bold"
        color "$color.fg"
    }
    part "account-setup.form" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
    }
    part "account-setup.candidates" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
    }
    part "account-setup.candidate" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
    }
    part "account-setup.candidate.servers" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "account-setup.candidate.warning" {
        font-size "$font-size.sm"
        color "$color.danger"
    }
    part "account-setup.warning" {
        padding "$space.sm" "$space.md"
        border-left "4px solid $color.danger"
        color "$color.danger"
    }
    part "account-setup.actions" {
        display "flex"
        justify-content "flex-end"
        gap "$space.sm"
    }
    part "account-setup.error" { color "$color.danger"; }
    part "account-setup.results" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        margin 0
        padding 0
    }
    part "account-setup.result" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        padding "$space.sm" "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
    }
    part "account-setup.result:ok" { border-left "4px solid $color.success"; }
    part "account-setup.result:error" { border-left "4px solid $color.danger"; }
    part "account-setup.result.title" { font-weight "$font-weight.bold"; }
    part "account-setup.result.capabilities" {
        font-size "$font-size.xs"
        color "$color.fg-muted"
    }
    part "account-setup.oauth" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
    }
    part "account-setup.oauth.link" { color "$color.accent"; }

    part "account-settings" {
        display "grid"
        grid-template-columns "220px minmax(0, 1fr)"
        min-height 0
        overflow "hidden"
    }
    part "account-settings.sidebar" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.sm"
        border-right "$border.thin"
        background-color "$color.bg-subtle"
        overflow-y "auto"
    }
    part "account-settings.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "account-settings.account" {
        display "flex"
        flex-direction "column"
        width "100%"
        padding "$space.xs" "$space.sm"
        border "none"
        border-radius "$radius.sm"
        text-align "left"
        color "$color.fg"
        background-color "transparent"
    }
    part "account-settings.account:selected" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    part "account-settings.account.email" { font-size "$font-size.sm"; }
    part "account-settings.account.status" { font-size "$font-size.xs"; }
    part "account-settings.form" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.lg"
        overflow-y "auto"
    }
    part "account-settings.identities" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        margin 0
        padding 0
    }
    part "account-settings.identity" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "account-settings.actions" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
    }
    part "account-settings.problem" { color "$color.danger"; }
    part "account-settings.message:error" { color "$color.danger"; }

    part "virtual-editor" {
        display "grid"
        grid-template-columns "220px minmax(0, 1fr)"
        min-height 0
        overflow "hidden"
    }
    part "virtual-editor.sidebar" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.sm"
        border-right "$border.thin"
        background-color "$color.bg-subtle"
        overflow-y "auto"
    }
    part "virtual-editor.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "virtual-editor.account" {
        width "100%"
        padding "$space.xs" "$space.sm"
        border "none"
        border-radius "$radius.sm"
        text-align "left"
        color "$color.fg"
        background-color "transparent"
    }
    part "virtual-editor.account:selected" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    part "virtual-editor.form" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.lg"
        overflow-y "auto"
    }
    part "virtual-editor.mapping" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "virtual-editor.source" {
        display "flex"
        flex-wrap "wrap"
        align-items "flex-end"
        gap "$space.sm"
    }
    part "virtual-editor.rule" {
        display "flex"
        flex-wrap "wrap"
        align-items "flex-end"
        gap "$space.sm"
    }
    part "virtual-editor.actions" {
        display "flex"
        gap "$space.sm"
    }
    part "virtual-editor.problem" { color "$color.danger"; }
    part "virtual-editor.message:error" { color "$color.danger"; }

    // ---- Composer ----

    part "composer" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md" "$space.lg"
        min-height 0
        // Scrolls inside its row; the security slot below stays in view.
        overflow-y "auto"
    }
    part "composer.field" {
        display "grid"
        grid-template-columns "80px minmax(0, 1fr)"
        align-items "center"
        gap "$space.sm"
        padding-bottom "$space.xs"
        border-bottom "$border.thin"
    }
    part "composer.field.label" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "composer.field.input" {
        padding "$space.xs" 0
        border "none"
        color "$color.fg"
        background-color "transparent"
    }
    part "composer.field.input:focus-visible" { outline "2px solid $color.focus-ring"; }
    part "composer.identity" {
        padding "$space.xs"
        border "$border.control"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "composer.extra-fields" {
        display "flex"
        gap "$space.sm"
    }
    part "composer.body.label" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "composer.body" {
        flex-grow 1
        min-height 200
        padding "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        font-family "$font.mono"
        line-height "$line-height.normal"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "composer.body:focus-visible" { outline "2px solid $color.focus-ring"; }
    part "composer.error" { color "$color.danger"; }
    part "composer.send-later" {
        display "flex"
        align-items "center"
        gap "$space.sm"
    }
    part "composer.actions" {
        display "flex"
        align-items "center"
        gap "$space.sm"
    }
    part "composer.spacer" { flex-grow 1; }
    part "composer.saved" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "composer.empty" {
        margin "auto"
        color "$color.fg-muted"
    }

    // Rich composer (ADR 0023): modes, formatting toolbar, HTML / Markdown
    // editors, preview, attachments, address suggestions.
    part "composer.toolbar" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
    }
    part "composer.modes" {
        display "inline-flex"
        border "$border.thin"
        border-radius "$radius.sm"
        overflow "hidden"
    }
    part "composer.mode" {
        padding "$space.xs" "$space.sm"
        border "none"
        color "$color.fg"
        background-color "transparent"
    }
    part "composer.mode:hover" { background-color "$color.bg-subtle"; }
    part "composer.mode:selected" {
        color "$color.selection-fg"
        background-color "$color.selection"
        font-weight "$font-weight.bold"
    }
    part "composer.mode:focus-visible" { outline "2px solid $color.focus-ring"; }
    part "composer.option" {
        display "inline-flex"
        align-items "center"
        gap "$space.xs"
        font-size "$font-size.sm"
    }
    part "composer.address" { position "relative"; }
    part "composer.suggestions" {
        position "absolute"
        z-index 10
        min-width 240
        margin 0
        padding "$space.xs" 0
        border "$border.thin"
        border-radius "$radius.sm"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "composer.suggestion" {
        display "flex"
        gap "$space.sm"
        padding "$space.xs" "$space.sm"
        cursor "pointer"
    }
    part "composer.suggestion:active" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    part "composer.suggestion.email" { color "$color.fg-muted"; }
    part "composer.format" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.xs"
    }
    part "composer.format.button" {
        padding "$space.xs" "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "transparent"
    }
    part "composer.format.button:hover" { background-color "$color.bg-subtle"; }
    part "composer.format.button:active" { background-color "$color.bg-raised"; }
    part "composer.format.button:focus-visible" { outline "2px solid $color.focus-ring"; }
    part "composer.format.label" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "composer.html" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        flex-grow 1
        min-height 0
    }
    part "composer.html.editor" {
        display "flex"
        flex-direction "column"
        flex-grow 1
        min-height 0
        overflow-y "auto"
    }
    part "composer.html.content" {
        min-height 200
        padding "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
        font-family "$font.reader"
        line-height "$line-height.normal"
        white-space "pre-wrap"
        overflow-wrap "break-word"
        outline "none"
    }
    part "composer.html.content:focus-within" { outline "2px solid $color.focus-ring"; }
    part "composer.html.source" {
        min-height 200
        padding "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        font-family "$font.mono"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "composer.link" {
        display "flex"
        align-items "center"
        gap "$space.sm"
    }
    part "composer.link.input" {
        flex-grow 1
        padding "$space.xs" "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "composer.markdown" {
        display "grid"
        grid-template-columns "minmax(0, 1fr)"
        gap "$space.sm"
        flex-grow 1
        min-height 0
    }
    part "composer.markdown:split" { grid-template-columns "minmax(0, 1fr) minmax(0, 1fr)"; }
    part "composer.markdown.source" {
        display "flex"
        flex-direction "column"
        min-height 0
    }
    part "composer.markdown.editor" {
        flex-grow 1
        min-height 200
        border "$border.thin"
        border-radius "$radius.sm"
        font-family "$font.mono"
        overflow "auto"
    }
    part "composer.markdown.content" {
        padding "$space.sm"
        font-family "$font.mono"
        line-height "$line-height.normal"
    }
    part "composer.preview" {
        display "flex"
        min-height 200
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "composer.preview.frame" {
        flex-grow 1
        border "none"
        background-color "#ffffff"
    }
    part "composer.preview.error" {
        padding "$space.sm"
        color "$color.danger"
    }
    part "composer.lossy" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.sm"
        border-radius "$radius.sm"
        background-color "$color.bg-raised"
    }
    part "composer.reminder" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "composer.reminder:confirm" {
        padding "$space.sm"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg-raised"
    }
    part "composer.attachments" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "composer.attachments.list" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "composer.attachment" {
        display "inline-flex"
        align-items "center"
        gap "$space.xs"
        padding "$space.xxs" "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "composer.attachment.size" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "composer.attachment.inline" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "composer.file-input" { display "none"; }
    part "composer.uploading" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "composer.saved:failed" { color "$color.danger"; }

    // ---- Outbox and move picker ----

    part "outbox" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md" "$space.lg"
        overflow-y "auto"
    }
    part "outbox.item" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        padding "$space.sm" "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
    }
    part "outbox.item:failed" { border-left "4px solid $color.danger"; }
    part "outbox.item.subject" { font-weight "$font-weight.bold"; }
    part "outbox.item.recipients" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "outbox.item.status" {
        display "flex"
        gap "$space.sm"
        font-size "$font-size.sm"
    }
    part "outbox.item.error" { color "$color.danger"; }
    part "outbox.item.progress" { width "8rem"; accent-color "$color.accent"; }
    part "outbox.item.actions" {
        display "flex"
        gap "$space.sm"
    }
    part "outbox.drafts" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        margin-top "$space.md"
    }
    part "outbox.drafts.title" {
        margin 0
        font-size "$font-size.md"
        font-weight "$font-weight.bold"
    }
    part "outbox.empty" {
        margin "auto"
        color "$color.fg-muted"
    }
    part "folder-picker" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md"
        overflow-y "auto"
    }
    part "folder-picker.filter" {
        display "grid"
        gap "$space.xs"
        font-size "$font-size.small"
        font-weight "$font-weight.medium"
    }
    part "folder-picker.input" {
        min-height "$size.control"
        padding 0 "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        font-size "$font-size.body"
        color "$color.fg"
        background-color "$color.bg-subtle"
    }
    part "folder-picker.input:focus-visible" { outline "2px solid $color.focus-ring"; outline-offset 0; }
    part "folder-picker.button" {
        display "flex"
        align-items "center"
        gap "$space.sm"
        width "100%"
        padding "$space.xs" "$space.sm"
        border "none"
        border-radius "$radius.sm"
        text-align "left"
        color "$color.fg"
        background-color "transparent"
    }
    part "folder-picker.button:hover" { background-color "$color.bg-raised"; }
    part "folder-picker.button:focus-visible" {
        outline "2px solid $color.focus-ring"
        outline-offset -2
    }
    part "folder-picker.button.icon" {
        width "$size.icon"
        height "$size.icon"
        color "$color.fg-muted"
    }

    // ---- Filter rules (ADR 0024) ----

    part "window[window=\"rules\"]" { width "min(1100px, 100%)"; }
    part "rules" {
        display "grid"
        grid-template-columns "minmax(200px, 280px) minmax(0, 1fr)"
        gap "$space.md"
        height "100%"
        min-height 0
        padding "$space.md"
    }
    part "rules.list" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        min-height 0
        overflow-y "auto"
    }
    part "rules.list.items" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "rules.list.item" {
        display "flex"
        align-items "center"
        gap "$space.xs"
        padding "$space.xxs" "$space.xs"
        border-radius "$radius.sm"
    }
    part "rules.list.item[selected=\"true\"]" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    part "rules.list.item[enabled=\"false\"]" { opacity "$opacity.muted"; }
    part "rules.list.select" {
        flex-grow 1
        padding "$space.xs"
        border "none"
        text-align "left"
        color "inherit"
        background-color "transparent"
    }
    part "rules.list.select:focus-visible" { outline "2px solid $color.focus-ring"; }
    part "rules.list.triggers" {
        font-size "$font-size.xs"
        color "$color.fg-muted"
    }
    part "rules.editor" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        min-height 0
        overflow-y "auto"
    }
    part "rules.views" {
        display "inline-flex"
        gap "$space.xs"
    }
    part "rules.view" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "rules.conditions" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "rules.group" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding "$space.sm"
        border "$border.thin"
        border-radius "$radius.md"
    }
    part "rules.group[mode=\"not\"]" { border-left "3px solid $color.warning"; }
    part "rules.group.title" {
        display "flex"
        align-items "center"
        gap "$space.sm"
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "rules.group.items" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "rules.group.item" {
        display "flex"
        align-items "flex-start"
        gap "$space.xs"
    }
    part "rules.condition" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.xs"
        flex-grow 1
    }
    part "rules.add" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.xs"
    }
    part "rules.actions" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "rules.actions.items" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "rules.action" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.xs"
    }
    part "rules.text" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "rules.text.source" {
        min-height 240
        padding "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        font-family "$font.mono"
        white-space "pre"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "rules.text.errors" {
        margin 0
        padding-left "$space.lg"
        color "$color.danger"
    }
    part "rules.problems" {
        padding "$space.sm"
        border-radius "$radius.sm"
        background-color "$color.bg-raised"
    }
    part "rules.problems.title" { font-weight "$font-weight.bold"; }
    part "rules.problems.items" {
        margin 0
        padding-left "$space.lg"
    }
    part "rules.problem" { color "$color.danger"; }
    part "rules.notice" {
        padding "$space.xs" "$space.sm"
        border-radius "$radius.sm"
        background-color "$color.bg-subtle"
    }
    part "rules.notice[kind=\"error\"]" { color "$color.danger"; }
    part "rules.notice[kind=\"ok\"]" { color "$color.success"; }
    part "rules.buttons" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.sm"
    }
    part "rules.hint" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "rules.test" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "rules.test.summary" { font-weight "$font-weight.bold"; }
    part "rules.test.matches" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "rules.test.match" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        padding "$space.xs" "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "rules.test.subject" { font-weight "$font-weight.medium"; }
    part "rules.test.from" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "rules.test.actions" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.xs"
        margin 0
        padding 0
        font-size "$font-size.sm"
    }
    part "rules.test.why" {
        margin 0
        padding-left "$space.lg"
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "rules.runs" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "rules.runs.title" { font-weight "$font-weight.bold"; }
    part "rules.runs.items" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "rules.run" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        font-size "$font-size.sm"
    }
    part "rules.run:failed" { color "$color.danger"; }
    part "rules.run:undone" { color "$color.fg-muted"; }

    // ---- MCP clients and the agent indicator (ADR 0025) ----

    part "mcp-clients" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "mcp-clients.intro" { color "$color.fg-muted"; }
    part "mcp-clients.server" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "mcp-clients.server:running" { color "$color.success"; }
    part "mcp-clients.create" {
        display "flex"
        flex-wrap "wrap"
        align-items "flex-end"
        gap "$space.sm"
    }
    part "mcp-clients.create.error" { color "$color.danger"; }
    part "mcp-clients.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "mcp-clients.client" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        width "100%"
        padding "$space.xs" "$space.sm"
        border "none"
        border-radius "$radius.sm"
        text-align "left"
        color "inherit"
        background-color "transparent"
    }
    part "mcp-clients.client:hover" { background-color "$color.bg-subtle"; }
    part "mcp-clients.client:selected" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    part "mcp-clients.client[access=\"revoked\"]" { opacity "$opacity.muted"; }
    part "mcp-clients.client.name" { font-weight "$font-weight.medium"; }
    part "mcp-clients.client.status" { font-size "$font-size.sm"; }
    part "mcp-clients.client.status[access=\"no-access\"]" { color "$color.warning"; }
    part "mcp-clients.client.hint" {
        font-size "$font-size.xs"
        color "$color.fg-muted"
    }
    part "mcp-clients.client.used" {
        font-size "$font-size.xs"
        color "$color.fg-muted"
    }
    part "mcp-clients.detail" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
    }
    part "mcp-clients.confirm" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.sm"
        border-radius "$radius.sm"
        background-color "$color.bg-raised"
    }
    part "mcp-clients.error" { color "$color.danger"; }
    part "mcp-clients.empty" { color "$color.fg-muted"; }
    part "mcp-token" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md"
        border "2px solid $color.accent"
        border-radius "$radius.md"
    }
    part "mcp-token.title" { font-weight "$font-weight.bold"; }
    part "mcp-token.warning" { color "$color.warning"; }
    part "mcp-token.value" {
        padding "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
        font-family "$font.mono"
        overflow-wrap "anywhere"
        user-select "all"
        background-color "$color.bg-subtle"
    }
    part "mcp-token.actions" {
        display "flex"
        gap "$space.sm"
    }
    part "mcp-token.usage" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "mcp-token.copy-failed" { color "$color.danger"; }
    part "mcp-grants" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "mcp-grants.fields" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding "$space.sm"
        border "$border.thin"
        border-radius "$radius.md"
    }
    part "mcp-grants.empty" { color "$color.warning"; }
    part "mcp-grants.scope" {
        display "flex"
        align-items "center"
        gap "$space.sm"
    }
    part "mcp-grants.scope.hint" {
        font-size "$font-size.xs"
        color "$color.fg-muted"
    }
    part "mcp-grants.folders.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        padding-left "$space.lg"
    }
    part "mcp-grants.actions" {
        display "flex"
        gap "$space.sm"
    }
    part "mcp-grants.message" { font-size "$font-size.sm"; }
    part "mcp-grants.message:ok" { color "$color.success"; }
    part "mcp-grants.message:error" { color "$color.danger"; }
    part "mcp-audit" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "mcp-audit.toolbar" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
    }
    part "mcp-audit.table" {
        width "100%"
        font-size "$font-size.sm"
    }
    part "mcp-audit.head" {
        text-align "left"
        color "$color.fg-muted"
    }
    part "mcp-audit.row" { border-bottom "$border.thin"; }
    part "mcp-audit.outcome[outcome=\"denied\"]" { color "$color.danger"; }
    part "mcp-audit.outcome[outcome=\"error\"]" { color "$color.danger"; }
    part "mcp-audit.outcome[outcome=\"declined\"]" { color "$color.warning"; }
    part "mcp-audit.detail" { color "$color.fg-muted"; }
    part "mcp-audit.error" { color "$color.danger"; }
    part "mcp-audit.empty" { color "$color.fg-muted"; }
    part "mcp-context-indicator" {
        display "flex"
        align-items "center"
        gap "$space.sm"
        font-weight "$font-weight.bold"
    }
    part "mcp-context-indicator:reading" {
        padding "$space.xs" "$space.md"
        color "$color.accent-fg"
        background-color "$color.accent"
    }
    part "mcp-context-indicator:editing" {
        padding "$space.xs" "$space.md"
        color "$color.accent-fg"
        background-color "$color.danger"
    }
    part "mcp-context-indicator.dot" {
        width 10
        height 10
        border-radius "50%"
        background-color "currentColor"
    }
    part "mcp-context-indicator.dismiss" {
        display "inline-flex"
        margin-left "auto"
        padding "$space.xxs" "$space.sm"
        border "1px solid currentColor"
        border-radius "$radius.sm"
        color "inherit"
        background-color "transparent"
    }

    // ---- Customization: inspector, merge dialog, config errors, smart folders (ADR 0026) ----

    part "inspector" {
        position "fixed"
        right 16
        bottom 16
        z-index 1000
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        max-width "min(480px, calc(100vw - 32px))"
        max-height "70vh"
        overflow "auto"
        padding "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
        font-size "$font-size.sm"
        color "$color.fg"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "inspector.highlight" {
        position "fixed"
        z-index 999
        outline "2px solid $color.accent"
        background-color "rgb(46 94 170 / 0.12)"
        pointer-events "none"
    }
    part "inspector.header" {
        display "flex"
        align-items "center"
        gap "$space.sm"
    }
    part "inspector.title" { font-weight "$font-weight.bold"; }
    part "inspector.hint" { color "$color.fg-muted"; }
    part "inspector.section" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
    }
    part "inspector.heading" {
        margin 0
        font-size "$font-size.sm"
        font-weight "$font-weight.bold"
    }
    part "inspector.path" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.xxs"
        margin 0
        padding 0
        font-family "$font.mono"
    }
    part "inspector.path.item:current" { font-weight "$font-weight.bold"; }
    part "inspector.states" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "inspector.state" {
        padding 0 "$space.xs"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "inspector.condition" { font-family "$font.mono"; }
    part "inspector.rules" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "inspector.rule" {
        padding "$space.xs"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "inspector.rule.selector" { font-family "$font.mono"; }
    part "inspector.rule.declarations" {
        margin 0
        padding-left "$space.lg"
        font-family "$font.mono"
    }
    part "inspector.node" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.sm"
    }
    part "inspector.node.kind" { font-family "$font.mono"; }
    part "inspector.none" { color "$color.fg-muted"; }
    part "window[window=\"config-merge\"]" { width "min(1100px, 100%)"; }
    part "merge-dialog" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "merge-dialog.intro" { color "$color.fg-muted"; }
    part "merge-dialog.files" {
        display "flex"
        gap "$space.md"
        margin 0
        padding 0
        border "none"
    }
    part "merge-dialog.input" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "merge-dialog.text" {
        min-height 160
        padding "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        font-family "$font.mono"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "merge-dialog.toolbar" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
    }
    part "merge-dialog.section" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "merge-dialog.section.header" {
        display "flex"
        align-items "center"
        gap "$space.sm"
        font-weight "$font-weight.bold"
    }
    part "merge-dialog.items" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "merge-dialog.item" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        padding "$space.xs" "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "merge-dialog.item.header" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
    }
    part "merge-dialog.item.key" { font-family "$font.mono"; }
    part "merge-dialog.diff" {
        display "grid"
        grid-template-columns "minmax(0, 1fr) minmax(0, 1fr)"
        gap "$space.sm"
    }
    part "merge-dialog.side" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        min-width 0
    }
    part "merge-dialog.side:mine" { border-left "3px solid $color.accent"; }
    part "merge-dialog.side:theirs" { border-left "3px solid $color.success"; }
    part "merge-dialog.side.label" {
        font-size "$font-size.xs"
        color "$color.fg-muted"
    }
    part "merge-dialog.side.text" {
        margin 0
        padding "$space.xs"
        font-family "$font.mono"
        white-space "pre"
        overflow-x "auto"
        background-color "$color.bg-subtle"
    }
    part "merge-dialog.side.absent" { color "$color.fg-muted"; }
    part "merge-dialog.choice" {
        display "flex"
        gap "$space.sm"
        margin 0
        padding 0
        border "none"
    }
    part "merge-dialog.conflicts" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "merge-dialog.conflict" {
        padding 0 "$space.xs"
        border-radius "$radius.sm"
        font-size "$font-size.xs"
        color "$color.accent-fg"
        background-color "$color.warning"
    }
    part "merge-dialog.error" { color "$color.danger"; }
    part "merge-dialog.error-list" { color "$color.danger"; }
    part "merge-dialog.status" { color "$color.fg-muted"; }
    part "merge-dialog.actions" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.sm"
    }
    part "merge-dialog.backups" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "merge-dialog.backup-list" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "merge-dialog.backup" {
        display "flex"
        align-items "center"
        gap "$space.sm"
    }
    part "merge-dialog.upload.input" { display "none"; }
    part "config-errors" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "config-errors:invalid" {
        padding "$space.sm" "$space.md"
        border-bottom "$border.thin"
        color "$color.fg"
        background-color "$color.bg-raised"
    }
    part "config-errors.summary" {
        font-weight "$font-weight.bold"
        color "$color.danger"
    }
    part "config-errors.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "config-errors.file" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
    }
    part "config-errors.file.name" {
        font-family "$font.mono"
        font-weight "$font-weight.bold"
    }
    part "config-errors.item" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        font-size "$font-size.sm"
    }
    part "config-errors.item.message" { font-family "$font.mono"; }
    part "config-errors.note" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "smart-folders" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        padding "$space.xs" "$space.sm"
        border-top "$border.thin"
    }
    part "smart-folders.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "smart-folders.entry" {
        display "flex"
        align-items "center"
        gap "$space.xxs"
    }
    part "smart-folders.item" {
        flex-grow 1
        padding "$space.xs" "$space.sm"
        border "none"
        border-radius "$radius.sm"
        text-align "left"
        color "$color.fg"
        background-color "transparent"
    }
    part "smart-folders.item:hover" { background-color "$color.bg-raised"; }
    part "smart-folders.item:selected" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    part "smart-folders.remove" {
        padding "$space.xxs" "$space.xs"
        border "none"
        color "$color.fg-muted"
        background-color "transparent"
    }
    part "smart-folders.form" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "smart-folders.empty" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "smart-folders.error" { color "$color.danger"; }

    // ---- Reading mail ----

    // The reader body: the UI face for HTML and plain text alike (choose
    // `$font.mono` for `text-font-family` to read plain text in monospace),
    // at most about 68 characters per line.
    message {
        font-family "$font.reader"
        text-font-family "$font.reader"
        font-size "$font-size.md"
        line-height "$line-height.relaxed"
        max-width "68ch"
        quote-colors "$color.quote-1" "$color.quote-2" "$color.quote-3"
        html-dark-mode "smart"
    }

    // Notification sounds per event, e.g. `mail.new "chime"`. Silent by default.
    sounds {
    }

    // ---- Security: badges, warnings, composer toggles, settings (ADRs 0033, 0034) ----

    part "security-message" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.xs"
        padding "$space.xs" "$space.md"
    }
    part "security-message.slot" { display "flex"; flex-wrap "wrap"; gap "$space.xs"; }
    part "security-badge.anchor" { position "relative"; display "inline-block"; }
    part "auth-badge.anchor" { position "relative"; display "inline-block"; }
    part "security-badge" {
        display "inline-flex"
        align-items "center"
        gap "$space.xxs"
        padding "$space.xxs" "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
        font-size "$font-size.sm"
        color "inherit"
        background-color "$color.bg-subtle"
        cursor "pointer"
    }
    part "auth-badge" {
        display "inline-flex"
        align-items "center"
        gap "$space.xxs"
        padding "$space.xxs" "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
        font-size "$font-size.sm"
        color "inherit"
        background-color "$color.bg-subtle"
        cursor "pointer"
    }
    part "security-badge[tone=\"good\"]" { color "$color.success"; }
    part "security-badge[tone=\"warning\"]" { color "$color.warning"; }
    part "security-badge[tone=\"danger\"]" { color "$color.danger"; }
    part "auth-badge[tone=\"good\"]" { color "$color.success"; }
    part "auth-badge[tone=\"warning\"]" { color "$color.warning"; }
    part "auth-badge[tone=\"danger\"]" { color "$color.danger"; }
    part "security-badge.popover" {
        position "absolute"
        z-index 20
        min-width 320
        max-width 480
        padding "$space.md"
        border "$border.thin"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "auth-badge.popover" {
        position "absolute"
        z-index 20
        min-width 320
        max-width 480
        padding "$space.md"
        border "$border.thin"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "security-details.row" {
        display "grid"
        grid-template-columns "10em 1fr"
        gap "$space.sm"
    }
    part "security-details.warning" { color "$color.warning"; }
    part "security-details.error" { color "$color.danger"; }
    part "auth-details.method" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.sm"
    }
    part "security-fingerprint" { font-family "$font.mono"; }
    part "security-trust[trust=\"rejected\"]" { color "$color.danger"; }
    part "security-trust[trust=\"verified\"]" { color "$color.success"; }
    part "security-trust[trust=\"own\"]" { color "$color.success"; }
    part "security-chain.revocation" { color "$color.fg-muted"; font-size "$font-size.sm"; }

    part "security-warnings" {
        padding "$space.sm" "$space.md"
        border-left "3px solid $color.warning"
        background-color "$color.bg-subtle"
    }
    part "security-warnings.target" {
        display "block"
        font-family "$font.mono"
        font-size "$font-size.sm"
        word-break "break-all"
    }
    part "security-attachment-warning" { color "$color.danger"; font-size "$font-size.sm"; }

    part "security-compose.slot" {
        padding "$space.sm" "$space.md"
        border-top "$border.thin"
        background-color "$color.bg-subtle"
    }
    part "security-compose" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "security-compose.toggles" {
        display "flex"
        flex-wrap "wrap"
        align-items "flex-end"
        gap "$space.sm"
    }
    part "security-compose.recipients" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "security-compose.recipient" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.sm"
        font-size "$font-size.sm"
    }
    part "security-compose.recipient[state=\"usable\"]" { color "$color.success"; }
    part "security-compose.recipient.state" { color "$color.fg-muted"; }
    part "security-compose.block" { color "$color.danger"; }
    part "security-compose.error" { color "$color.danger"; }

    part "security-keys" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "security-identities" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "security-settings" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "security-autocrypt" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "security-keys.tools" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.sm"
        align-items "flex-end"
    }
    part "security-keys.filters" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.sm"
        align-items "flex-end"
    }
    part "security-keys.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "security-keys.key" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        width "100%"
        padding "$space.xs" "$space.sm"
        border "none"
        border-radius "$radius.sm"
        text-align "left"
        color "inherit"
        background-color "transparent"
    }
    part "security-keys.key:hover" { background-color "$color.bg-subtle"; }
    part "security-keys.key:selected" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    // The trust colour has too little contrast on the selection colour.
    part "security-keys.key:selected security-trust" { color "inherit"; }
    part "security-keys.key[key-state=\"revoked\"]" { opacity "$opacity.muted"; }
    part "security-keys.key[key-state=\"expired\"]" { opacity "$opacity.muted"; }
    part "security-keys.key.fingerprint" { font-family "$font.mono"; font-size "$font-size.sm"; }
    part "security-key.state" { color "$color.warning"; }
    part "security-key.error" { color "$color.danger"; }
    part "security-key.exported.text" { font-family "$font.mono"; min-height 160; }
    part "security-vault.recommendation" {
        color "$color.accent"
        font-weight "$font-weight.medium"
    }
    part "security-vault.bar" { width "100%"; }
    part "security-vault.failed" { color "$color.warning"; }
    part "security-vault.error" { color "$color.danger"; }
    part "security-settings.warning" { color "$color.warning"; }
    part "security-settings.error" { color "$color.danger"; }
    part "security-autocrypt.code.value" {
        font-family "$font.mono"
        font-size "$font-size.lg"
    }
    part "security-autocrypt.code.warning" { color "$color.warning"; }
    part "security-autocrypt.error" { color "$color.danger"; }
    part "form.file" { font "inherit"; }

    // ---- Remote UI and privacy: login, pairing, users, devices, audit, remote content (ADR 0039) ----

    part "remote-login" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        max-width 420
        margin "$space.xl" "auto"
        padding "$space.lg"
        border "$border.thin"
        border-radius "$radius.md"
        background-color "$color.bg"
        box-shadow "$shadow.raised"
    }
    part "remote-login.title" { margin 0; font-size "$font-size.xl"; }
    part "remote-login.intro" { margin 0; color "$color.fg-muted"; }
    part "remote-login.form" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "remote-login.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "remote-login.notices" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "remote-login.notice" { margin 0; }
    part "remote-login.notice:error" { color "$color.danger"; }
    part "remote-login.wait" { color "$color.warning"; }
    part "remote-login.note" { color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "remote-login.fingerprint" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "remote-reauth" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md"
    }
    part "remote-reauth.title" { margin 0; font-size "$font-size.lg"; }
    part "remote-fingerprint" {
        font-family "$font.mono"
        font-size "$font-size.sm"
        overflow-wrap "anywhere"
    }
    part "remote-qr" { width 180; height 180; }
    part "remote-qr.background" { fill "#ffffff"; }
    part "remote-qr.modules" { fill "#000000"; }
    part "remote-confirm" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
    }
    part "remote-confirm.text" { color "$color.warning"; }

    part "remote-settings" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "remote-users" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "remote-devices" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "remote-audit" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "remote-allows" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "remote-pair" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
    }
    part "remote-settings.form" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "remote-settings.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "remote-settings.status" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "remote-settings.state" { font-weight "$font-weight.medium"; }
    part "remote-settings.state:failed" { color "$color.danger"; }
    part "remote-settings.state:running" { color "$color.success"; }
    part "remote-settings.urls" { margin 0; padding-left "$space.lg"; }
    part "remote-settings.url.text" { font-family "$font.mono"; overflow-wrap "anywhere"; }
    part "remote-settings.certificate" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "remote-settings.issues" { margin 0; color "$color.danger"; }
    part "remote-settings.error" { color "$color.danger"; }
    part "remote-settings.warning" { color "$color.warning"; }
    part "remote-settings.notice:error" { color "$color.danger"; }
    part "remote-settings.internet" { color "$color.fg-muted"; }
    part "form.hint:locked" { color "$color.fg-muted"; }

    part "remote-users.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xxs"
        margin 0
        padding 0
    }
    part "remote-users.select" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        width "100%"
        padding "$space.xs" "$space.sm"
        border "none"
        border-radius "$radius.sm"
        text-align "left"
        color "inherit"
        background-color "transparent"
    }
    part "remote-users.select:hover" { background-color "$color.bg-subtle"; }
    part "remote-users.select:selected" {
        color "$color.selection-fg"
        background-color "$color.selection"
    }
    part "remote-users.select:disabled" { opacity "$opacity.muted"; }
    part "remote-users.detail" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "remote-users.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "remote-users.meta" { color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "remote-users.locked" { color "$color.danger"; }
    part "remote-users.badge" {
        padding "$space.xxs" "$space.xs"
        border "$border.thin"
        border-radius "$radius.sm"
        font-size "$font-size.xs"
    }
    part "remote-users.notice:error" { color "$color.danger"; }
    part "remote-totp" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "remote-totp.secret" { font-family "$font.mono"; overflow-wrap "anywhere"; }
    part "remote-passkeys" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "remote-passkeys.item" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "remote-passkeys.meta" { color "$color.fg-muted"; font-size "$font-size.sm"; }

    part "remote-devices.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "remote-devices.item" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.xs" 0
        border-bottom "$border.thin"
    }
    part "remote-devices.item:revoked" { opacity "$opacity.muted"; }
    part "remote-devices.meta" { color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "remote-devices.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "remote-devices.badge" {
        padding "$space.xxs" "$space.xs"
        border "$border.thin"
        border-radius "$radius.sm"
        font-size "$font-size.xs"
    }
    part "remote-devices.error" { color "$color.danger"; }
    part "remote-sessions.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "remote-sessions.item" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.xs" 0
        border-bottom "$border.thin"
    }
    part "remote-sessions.item:ended" { opacity "$opacity.muted"; }
    part "remote-sessions.meta" { color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "remote-pairing" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "remote-pairing.item" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }

    part "remote-pair.form" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "remote-pair.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "remote-pair.code-panel" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "remote-pair.code" {
        font-family "$font.mono"
        font-size "$font-size.xl"
        letter-spacing "0.15em"
        overflow-wrap "anywhere"
    }
    part "remote-pair.state:used" { color "$color.success"; }
    part "remote-pair.state:expired" { color "$color.warning"; }
    part "remote-pair.state:cancelled" { color "$color.fg-muted"; }
    part "remote-pair.error" { color "$color.danger"; }

    part "remote-audit.toolbar" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; align-items "flex-end"; }
    part "remote-audit.table" { width "100%"; font-size "$font-size.sm"; }
    part "remote-audit.row" { border-bottom "$border.thin"; }
    part "remote-audit.outcome[outcome=\"failure\"]" { color "$color.danger"; }
    part "remote-audit.outcome[outcome=\"denied\"]" { color "$color.danger"; }
    part "remote-audit.outcome[outcome=\"success\"]" { color "$color.success"; }
    part "remote-audit.error" { color "$color.danger"; }

    part "remote-content" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.sm" "$space.md"
        background-color "$color.bg-subtle"
    }
    part "remote-content:blocked" { border-left "3px solid $color.warning"; }
    part "remote-content:allowed" { border-left "3px solid $color.success"; }
    part "remote-content.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "remote-content.error" { color "$color.danger"; }
    part "remote-allows.list" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "remote-allows.item" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "remote-allows.value" { font-family "$font.mono"; overflow-wrap "anywhere"; }
    part "remote-allows.time" { color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "remote-allows.error" { color "$color.danger"; }

    part "remote-alerts" {
        position "fixed"
        right 16
        bottom 16
        z-index 1001
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        max-width 420
    }
    part "remote-alerts.toast" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        padding "$space.md"
        border "$border.thin"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "remote-alerts.toast[kind=\"lockout\"]" { border-left "3px solid $color.danger"; }
    part "remote-alerts.toast[kind=\"new-device\"]" { border-left "3px solid $color.warning"; }
    part "remote-alerts.title" { font-weight "$font-weight.bold"; }
    part "remote-alerts.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "remote-reauth.overlay" {
        position "fixed"
        top 0
        right 0
        bottom 0
        left 0
        z-index 1002
        display "flex"
        align-items "center"
        justify-content "center"
        background-color "$color.scrim"
    }
    part "remote-reauth.overlay remote-reauth" {
        max-width 420
        border "$border.thin"
        border-radius "$radius.md"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }

    // ---- Opening links and files (ADR 0041) ----

    part "launch-notice" {
        position "fixed"
        left 16
        bottom 16
        z-index 1001
        display "flex"
        align-items "center"
        gap "$space.sm"
        max-width 480
        padding "$space.md"
        border "$border.thin"
        border-left "3px solid $color.warning"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "launch-notice.text" { margin 0; }

    // ---- Context menus, triage, sync, Sieve, Customize editors (M2c, ADR 0047) ----

    part "context-menu.popup" { margin-top -4; }

    part "message-list.row:headers-only .preview" { font-style "italic"; }
    part "message-list.header" {
        gap "$space.sm"
        padding "$space.xs" "$space.md"
        font-size "$font-size.sm"
        font-weight "$font-weight.medium"
        color "$color.fg-muted"
        border-bottom "$border.thin"
        background-color "$color.bg-subtle"
    }
    part "message-list.row.columns" { gap "$space.sm"; }
    part "message-list.row.cell[column=\"date\"]" { color "$color.fg-muted"; }

    part "junk-verdict" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.xs" "$space.md"
        border-left "3px solid $color.warning"
        background-color "$color.bg-subtle"
    }
    part "junk-verdict.source" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "sync-message-body" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.xs" "$space.md"
        border-left "3px solid $color.accent"
        background-color "$color.bg-subtle"
    }
    part "sync-message-body:failed" { border-left-color "$color.danger"; }

    part "snooze" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        min-width 320
        padding "$space.md"
    }
    part "snooze.intro" { margin 0; }
    part "snooze.presets" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
    }
    part "snooze.preset" {
        display "flex"
        justify-content "space-between"
        gap "$space.lg"
        width "100%"
        padding "$space.sm" "$space.md"
        border "$border.thin"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "snooze.preset:hover" { background-color "$color.bg-raised"; }
    part "snooze.preset:focus-visible" { outline "2px solid $color.focus-ring"; }
    part "snooze.preset.time" { color "$color.fg-muted"; }
    part "snooze.actions" { display "flex"; gap "$space.sm"; }
    part "snooze.error" { margin 0; color "$color.danger"; }
    part "snooze-list" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        min-width 420
        padding "$space.md"
        overflow-y "auto"
    }
    part "snooze-list.item" {
        display "grid"
        grid-template-columns "1fr auto"
        gap "$space.xxs" "$space.md"
        padding "$space.sm" 0
        border-bottom "$border.thin"
    }
    part "snooze-list.subject" { font-weight "$font-weight.medium"; }
    part "snooze-list.from" { color "$color.fg-muted"; }
    part "snooze-list.until" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }

    part "sieve-status" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "vacation-editor" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "vacation-editor.form" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "vacation-editor.dates" { display "flex"; flex-wrap "wrap"; gap "$space.md"; }
    part "junk-settings" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "junk-settings.account" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "junk-settings.status" {
        display "grid"
        grid-template-columns "auto 1fr"
        gap "$space.xs" "$space.md"
        margin 0
    }
    part "junk-settings.status.value" { margin 0; }
    part "junk-settings.status.value:ready" { color "$color.success"; }
    part "notification-settings" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "notification-settings.times" { display "flex"; flex-wrap "wrap"; gap "$space.md"; }
    part "notification-settings.days" {
        display "flex"
        flex-wrap "wrap"
        gap "$space.sm" "$space.md"
        margin 0
        padding 0
        border "none"
    }
    part "notification-settings.accounts" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "sync-folder-policies" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "sync-policy" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "sync-policy.form" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "sync-policy.current" { margin 0; color "$color.fg-muted"; }
    part "sieve-status.details" {
        display "grid"
        grid-template-columns "auto 1fr"
        gap "$space.xs" "$space.md"
        margin 0
    }
    part "sieve-status.value" { margin 0; }
    part "sieve-status.state:failed .text" { color "$color.danger"; }
    part "sieve-status.state:in-sync .text" { color "$color.success"; }
    part "sieve-status.script" {
        max-height 240
        margin 0
        padding "$space.sm"
        overflow "auto"
        font-family "$font.mono"
        font-size "$font-size.sm"
        border "$border.thin"
        border-radius "$radius.sm"
        background-color "$color.bg-subtle"
    }
    part "sieve-status.rules" { border-collapse "collapse"; }
    part "sieve-status.rule" { border-bottom "$border.thin"; }
    part "sieve-status.rule[placement=\"server\"] .placement" { color "$color.success"; }
    part "sieve-status.rule.reasons" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "sieve-status.actions" { display "flex"; gap "$space.sm"; }
    part "sieve-status.issues" { color "$color.danger"; }
    part "sieve-status.error" { margin 0; color "$color.danger"; }
    part "vacation-editor.issues" { color "$color.danger"; }
    part "junk-settings.issues" { color "$color.danger"; }
    part "notification-settings.issues" { color "$color.danger"; }
    part "sync-policy.issues" { color "$color.danger"; }
    part "vacation-editor.actions" { display "flex"; gap "$space.sm"; }
    part "junk-settings.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "notification-settings.actions" { display "flex"; gap "$space.sm"; }
    part "sync-policy.actions" { display "flex"; gap "$space.sm"; }

    part "toolbar-editor" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "key-binding-editor" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "column-editor" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.md"
        overflow-y "auto"
    }
    part "toolbar-editor.items" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "column-editor.items" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "toolbar-editor.item" {
        display "flex"
        align-items "center"
        gap "$space.xs"
        padding "$space.xxs" "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "column-editor.item" {
        display "flex"
        align-items "center"
        gap "$space.xs"
        padding "$space.xxs" "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "toolbar-editor.item:focus-within" { border-color "$color.focus-ring"; }
    part "column-editor.item:focus-within" { border-color "$color.focus-ring"; }
    part "toolbar-editor.item[kind=\"separator\"]" { color "$color.fg-muted"; }
    part "toolbar-editor.item[kind=\"spacer\"]" { color "$color.fg-muted"; }
    part "toolbar-editor.item.label" { flex-grow 1; }
    part "column-editor.item.label" { flex-grow 1; }
    part "toolbar-editor.add" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "column-editor.add" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "toolbar-editor.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "column-editor.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "key-binding-editor.capture" {
        padding "$space.xs" "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        font-family "$font.mono"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "key-binding-editor.capture:focus-visible" { outline "2px solid $color.focus-ring"; }
    part "key-binding-editor.table" { border-collapse "collapse"; }
    part "key-binding-editor.row" { border-bottom "$border.thin"; }
    part "key-binding-editor.kbd" {
        padding 0 "$space.xs"
        border "$border.thin"
        border-radius "$radius.sm"
        font-family "$font.mono"
        font-size "$font-size.sm"
        background-color "$color.bg-subtle"
    }
    part "key-binding-editor.args" {
        padding-left "$space.xs"
        color "$color.fg-muted"
    }
    part "key-binding-editor.conflict" { margin 0; color "$color.warning"; }
    part "toolbar-editor.status:error" { color "$color.danger"; }
    part "key-binding-editor.status:error" { color "$color.danger"; }
    part "column-editor.status:error" { color "$color.danger"; }

    part "composer.editor-loading" {
        padding "$space.md"
        color "$color.fg-muted"
    }
    part "composer.editor-loading:failed" { color "$color.danger"; }

    // ---- Plug-ins (M2d): dialogs, trees, notifications, panels, install, manager ----
    // Every plug-in element has a generic part (`plugin.button`) and the
    // attribute `plugin="<id>"`; `plugin.<id>.<part>` styles one plug-in.

    part "plugin.dialog.backdrop" {
        padding "$space.xl"
        background-color "$color.scrim"
    }
    part "plugin.dialog" {
        width "min(560px, 100%)"
        border "$border.thin"
        border-radius "$radius.lg"
        color "$color.fg"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "plugin.dialog[size=\"small\"]" { width "min(400px, 100%)"; }
    part "plugin.dialog[size=\"large\"]" { width "min(900px, 100%)"; }
    part "plugin.dialog.header" {
        gap "$space.sm"
        padding "$space.sm" "$space.lg"
        border-bottom "$border.thin"
        background-color "$color.bg-subtle"
    }
    part "plugin.dialog.title" {
        font-size "$font-size.lg"
        font-weight "$font-weight.bold"
    }
    part "plugin.dialog.plugin" {
        color "$color.fg-muted"
        font-size "$font-size.sm"
    }
    part "plugin.dialog.close" {
        padding "$space.xs"
        border "none"
        color "$color.fg"
        background-color "transparent"
    }
    part "plugin.dialog.close.icon" {
        width "$size.icon"
        height "$size.icon"
    }
    part "plugin.dialog.body" {
        gap "$space.md"
        padding "$space.lg"
    }
    part "plugin.dialog.buttons" {
        gap "$space.sm"
        padding "$space.sm" "$space.lg" "$space.lg"
    }
    part "plugin.dialog.error" { color "$color.danger"; }
    part "plugin.tree" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "plugin.stack" { gap "$space.sm"; }
    part "plugin.field" { gap "$space.xs"; }
    part "plugin.field.label" {
        font-size "$font-size.sm"
        color "$color.fg-muted"
    }
    part "plugin.field.error" {
        color "$color.danger"
        font-size "$font-size.sm"
    }
    part "plugin.input" {
        padding "$space.xs" "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "plugin.textarea" {
        min-height 96
        padding "$space.xs" "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "plugin.select" {
        padding "$space.xs" "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "plugin.date" {
        padding "$space.xs" "$space.sm"
        border "$border.control"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "plugin.field[state=\"invalid\"] plugin.input" { border-color "$color.danger"; }
    part "plugin.field[state=\"invalid\"] plugin.textarea" { border-color "$color.danger"; }
    part "plugin.field[state=\"invalid\"] plugin.date" { border-color "$color.danger"; }
    part "plugin.text[appearance=\"heading\"]" {
        margin 0
        font-size "$font-size.lg"
        font-weight "$font-weight.bold"
    }
    part "plugin.text[appearance=\"muted\"]" { color "$color.fg-muted"; }
    part "plugin.text[appearance=\"strong\"]" { font-weight "$font-weight.bold"; }
    part "plugin.text[appearance=\"error\"]" { color "$color.danger"; }
    part "plugin.markdown.code" {
        font-family "$font.mono"
        font-size "$font-size.sm"
    }
    part "plugin.markdown.code-block" {
        padding "$space.sm"
        border-radius "$radius.sm"
        font-family "$font.mono"
        font-size "$font-size.sm"
        background-color "$color.bg-subtle"
    }
    part "plugin.markdown.link" { color "$color.accent"; }
    part "plugin.table" { border-collapse "collapse"; }
    part "plugin.table.header" {
        padding "$space.xs" "$space.sm"
        border-bottom "$border.thin"
        text-align "left"
        color "$color.fg-muted"
    }
    part "plugin.table.cell" { padding "$space.xs" "$space.sm"; }
    part "plugin.message-list.from" { color "$color.fg-muted"; }
    part "plugin.message-list.date" {
        color "$color.fg-muted"
        font-size "$font-size.sm"
    }
    part "plugin.button" {
        display "inline-flex"
        align-items "center"
        gap "$space.xs"
        padding "$space.xs" "$space.md"
        border "$border.thin"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg-subtle"
    }
    part "plugin.button:hover" { background-color "$color.bg-raised"; }
    part "plugin.button:focus-visible" {
        outline "2px solid $color.focus-ring"
        outline-offset 1
    }
    part "plugin.button:disabled" { opacity "$opacity.disabled"; }
    part "plugin.button[variant=\"primary\"]" {
        border-color "$color.accent"
        color "$color.accent-fg"
        background-color "$color.accent"
    }
    part "plugin.button[variant=\"danger\"]" {
        border-color "$color.danger"
        color "$color.danger"
    }
    part "plugin.button.icon" {
        width "$size.icon"
        height "$size.icon"
    }
    part "plugin.dialog.button" {
        padding "$space.xs" "$space.md"
        border "$border.thin"
        border-radius "$radius.sm"
        color "$color.fg"
        background-color "$color.bg-subtle"
    }
    part "plugin.dialog.button[variant=\"primary\"]" {
        border-color "$color.accent"
        color "$color.accent-fg"
        background-color "$color.accent"
    }
    part "plugin.notifications.list" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        margin 0
        padding 0
    }
    part "plugin.notification" {
        display "flex"
        gap "$space.sm"
        padding "$space.sm" "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
        color "$color.fg"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "plugin.notification[level=\"error\"]" { border-color "$color.danger"; }
    part "plugin.notification[level=\"warning\"]" { border-color "$color.warning"; }
    part "plugin.notification[level=\"success\"]" { border-color "$color.success"; }
    part "plugin.notification.plugin" {
        color "$color.fg-muted"
        font-size "$font-size.sm"
    }
    part "plugin.notification.title" { font-weight "$font-weight.bold"; }
    part "plugin.notification.dismiss" {
        border "none"
        color "$color.fg"
        background-color "transparent"
    }
    part "plugin.notification.dismiss.icon" {
        width "$size.icon"
        height "$size.icon"
    }
    part "plugin.panel.error" { color "$color.danger"; }
    part "plugin-panel" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md"
        overflow "auto"
    }
    part "plugin-panel.missing" { color "$color.fg-muted"; }

    part "plugin-install" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.lg"
    }
    part "plugin-install.heading" {
        margin 0
        font-size "$font-size.lg"
    }
    part "plugin-install.actions" { gap "$space.sm"; }
    part "plugin-install.status" { color "$color.fg-muted"; }
    part "plugin-manager" {
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.lg"
        overflow "auto"
    }
    part "plugin-manager.toolbar" { gap "$space.sm"; }
    part "plugin-manager.list" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        margin 0
        padding 0
    }
    part "plugin-manager.plugin" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
    }
    part "plugin-manager.header" {
        display "flex"
        align-items "center"
        gap "$space.sm"
    }
    part "plugin-manager.name" { font-weight "$font-weight.bold"; }
    part "plugin-manager.state" {
        color "$color.fg-muted"
        font-size "$font-size.sm"
    }
    part "plugin-manager.source" {
        color "$color.fg-muted"
        font-size "$font-size.sm"
    }
    part "plugin-manager.crash" { color "$color.danger"; }
    part "plugin-manager.error" { color "$color.danger"; }
    part "plugin-manager.actions" { gap "$space.sm"; }
    part "plugin-manager.empty" { color "$color.fg-muted"; }
    part "plugin-permissions" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "plugin-permissions.item" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        padding "$space.sm"
        border "$border.thin"
        border-radius "$radius.sm"
    }
    part "plugin-permissions.label" { font-weight "$font-weight.bold"; }
    part "plugin-permissions.hint" {
        color "$color.fg-muted"
        font-size "$font-size.sm"
    }
    part "plugin-permissions.error" { color "$color.danger"; }
    part "plugin-settings" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "plugin-settings.error" { color "$color.danger"; }
    part "plugin-logs" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        min-height 0
    }
    part "plugin-logs.list" {
        max-height 320
        margin 0
        padding 0
        overflow "auto"
        font-family "$font.mono"
        font-size "$font-size.sm"
    }
    part "plugin-logs.entry" {
        display "flex"
        gap "$space.sm"
    }
    part "plugin-logs.time" { color "$color.fg-muted"; }
    part "plugin-logs.entry[level=\"warn\"]" { color "$color.warning"; }
    part "plugin-logs.entry[level=\"error\"]" { color "$color.danger"; }
    part "plugin-logs.error" { color "$color.danger"; }
    part "plugin-placements" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
    }
    part "plugin-placements.items" {
        display "flex"
        flex-direction "column"
        gap "$space.xs"
        margin 0
        padding 0
    }
    part "plugin-placements.text" {
        font-family "$font.mono"
        font-size "$font-size.sm"
    }
    part "plugin-placements.conflict" { color "$color.warning"; }
    part "plugin-placements.error" { color "$color.danger"; }
    part "plugin-placements.actions" { gap "$space.sm"; }

    // ---- Calendars, contacts and tasks (M3a WP74, ADR 0062) ----

    // ---- Shared ----
    part "pim.nav.text" { font-size "$font-size.lg"; line-height 1; }
    part "pim.swatch" {
        display "inline-block"
        width 10
        height 10
        border-radius "50%"
        background-color "$color.accent"
    }
    part "pim.problem" { margin 0; color "$color.danger"; }

    // ---- Calendar widget ----
    part "calendar" {
        display "grid"
        grid-template-rows "auto auto minmax(0, 1fr)"
        min-height 0
        height "100%"
        color "$color.fg"
        background-color "$color.bg"
    }
    part "calendar.header" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.sm" "$space.md"
        border-bottom "$border.thin"
    }
    part "calendar.nav" { display "flex"; gap "$space.xs"; }
    part "calendar.nav.previous" { padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; background-color "$color.bg-subtle"; color "$color.fg"; }
    part "calendar.nav.next" { padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; background-color "$color.bg-subtle"; color "$color.fg"; }
    part "calendar.nav.today" { padding "$space.xs" "$space.md"; border "$border.thin"; border-radius "$radius.sm"; background-color "$color.bg-subtle"; color "$color.fg"; }
    part "calendar.nav.icon" { display "none"; }
    part "calendar.title" { flex "1"; margin 0; font-size "$font-size.lg"; font-weight "$font-weight.medium"; }
    part "calendar.views" { display "flex"; gap "$space.xxs"; }
    part "calendar.views.button" { padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; background-color "$color.bg"; color "$color.fg"; }
    part "calendar.views.button:selected" { color "$color.selection-fg"; background-color "$color.selection"; }
    part "calendar.new" { display "inline-flex"; align-items "center"; gap "$space.xs"; padding "$space.xs" "$space.md"; border-radius "$radius.sm"; border "1px solid $color.accent"; color "$color.accent-fg"; background-color "$color.accent"; }
    part "calendar.new.icon" { width "$size.icon"; height "$size.icon"; }

    // Time grid (day, multi-day, week, work week)
    part "calendar.time-grid" { display "grid"; grid-template-rows "auto auto minmax(0, 1fr)"; min-height 0; }
    part "calendar.head" { display "grid"; grid-template-columns "56px minmax(0, 1fr)"; border-bottom "$border.thin"; }
    part "calendar.head[zones=\"2\"]" { grid-template-columns "112px minmax(0, 1fr)"; }
    part "calendar.corner" { display "flex"; align-items "end"; justify-content "space-around"; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "calendar.head.days" { display "grid"; }
    part "calendar.day-head" { display "flex"; flex-direction "column"; align-items "center"; padding "$space.xs"; border 0; background-color "transparent"; color "$color.fg"; }
    part "calendar.day-head:today" { color "$color.accent"; font-weight "$font-weight.bold"; }
    part "calendar.day-head.date" { font-size "$font-size.lg"; }
    part "calendar.all-day" { display "grid"; grid-template-columns "56px minmax(0, 1fr)"; border-bottom "$border.thin"; }
    part "calendar.all-day[zones=\"2\"]" { grid-template-columns "112px minmax(0, 1fr)"; }
    part "calendar.all-day.label" { font-size "$font-size.xs"; color "$color.fg-muted"; padding "$space.xs"; }
    part "calendar.all-day.days" { display "grid"; min-height 24; }
    part "calendar.all-day.cell" { border 0; border-left "$border.thin"; background-color "transparent"; }
    part "calendar.all-day.events" { display "contents"; }
    part "calendar.all-day.item" { display "contents"; }
    part "calendar.scroll" { overflow-y "auto"; min-height 0; }
    part "calendar.body" { display "grid"; grid-template-columns "56px minmax(0, 1fr)"; }
    part "calendar.body[zones=\"2\"]" { grid-template-columns "56px 56px minmax(0, 1fr)"; }
    part "calendar.gutter" { display "flex"; flex-direction "column"; }
    part "calendar.hour" { display "block"; height 48; padding-right "$space.xs"; font-size "$font-size.xs"; color "$color.fg-muted"; text-align "right"; }
    part "calendar.canvas" { position "relative"; }
    part "calendar.slots" { display "grid"; }
    part "calendar.slot-row" { display "contents"; }
    part "calendar.slot" { height 48; border-top "$border.thin"; border-left "$border.thin"; }
    part "calendar.slot:today" { background-color "$color.bg-subtle"; }
    part "calendar.slot:focus-visible" { outline "2px solid $color.focus-ring"; outline-offset -2; }
    part "calendar.columns" { position "absolute"; top 0; right 0; bottom 0; left 0; display "grid"; pointer-events "none"; }
    part "calendar.column" { position "relative"; margin 0; padding 0; }
    part "calendar.column.item" { display "contents"; }
    part "calendar.event" {
        position "absolute"
        box-sizing "border-box"
        display "flex"
        flex-direction "column"
        overflow "hidden"
        padding "$space.xxs" "$space.xs"
        border 0
        border-left "4px solid $color.accent"
        border-radius "$radius.sm"
        pointer-events "auto"
        text-align "left"
        font-size "$font-size.sm"
        color "$color.fg"
        background-color "$color.bg-raised"
        cursor "grab"
    }
    part "calendar.event:focus-visible" { outline "2px solid $color.focus-ring"; z-index 2; }
    part "calendar.event:selected" { box-shadow "$shadow.overlay"; z-index 1; }
    part "calendar.event:tentative" { opacity 0.8; }
    part "calendar.event:dragging" { opacity 0.4; }
    part "calendar.event.time" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "calendar.event.title" { font-weight "$font-weight.medium"; }
    part "calendar.event.location" { font-size "$font-size.xs"; }
    part "calendar.event.badge" { display "none"; }
    part "calendar.event.resize" { position "absolute"; left 0; right 0; bottom 0; height 6; cursor "ns-resize"; }
    part "calendar.ghost" { position "absolute"; box-sizing "border-box"; border "2px dashed $color.accent"; border-radius "$radius.sm"; pointer-events "none"; }
    part "calendar.now" { position "absolute"; height 2; background-color "$color.danger"; pointer-events "none"; }
    part "calendar.zone" { padding "$space.xxs"; }

    // Chips: all-day row, month, agenda
    part "calendar.chip" {
        display "flex"
        gap "$space.xs"
        min-width 0
        overflow "hidden"
        margin "1px"
        padding "0" "$space.xs"
        border 0
        border-left "4px solid $color.accent"
        border-radius "$radius.sm"
        text-align "left"
        white-space "nowrap"
        font-size "$font-size.sm"
        color "$color.fg"
        background-color "$color.bg-raised"
    }
    part "calendar.chip:focus-visible" { outline "2px solid $color.focus-ring"; }
    part "calendar.chip:dragging" { opacity 0.4; }
    part "calendar.chip.time" { color "$color.fg-muted"; }
    part "calendar.chip.location" { display "none"; }
    part "calendar.chip.badge" { display "none"; }

    // Month
    part "calendar.month" { width "100%"; border-collapse "collapse"; }
    part "calendar.month.weekday" { padding "$space.xs"; font-size "$font-size.xs"; color "$color.fg-muted"; font-weight "$font-weight.regular"; }
    part "calendar.month.day" { height 96; padding "$space.xxs"; vertical-align "top"; border "$border.thin"; }
    part "calendar.month.day:outside" { color "$color.fg-muted"; background-color "$color.bg-subtle"; }
    part "calendar.month.day:today" { box-shadow "inset 0 0 0 2px $color.accent"; }
    part "calendar.month.day:drop-target" { background-color "$color.selection"; }
    part "calendar.month.day:focus-visible" { outline "2px solid $color.focus-ring"; outline-offset -2; }
    part "calendar.month.date" { display "block"; font-size "$font-size.sm"; }
    part "calendar.month.events" { display "flex"; flex-direction "column"; margin 0; padding 0; }
    part "calendar.month.more" { border 0; padding 0; color "$color.accent"; background-color "transparent"; font-size "$font-size.xs"; }

    // Year
    part "calendar.year" { display "grid"; grid-template-columns "repeat(auto-fill, minmax(200px, 1fr))"; gap "$space.lg"; padding "$space.md"; overflow-y "auto"; }
    part "calendar.year.month" { border-collapse "collapse"; font-size "$font-size.xs"; }
    part "calendar.year.month.day" { padding "$space.xxs"; text-align "center"; cursor "pointer"; }
    part "calendar.year.month.day:outside" { color "$color.fg-muted"; }
    part "calendar.year.month.day:busy" { font-weight "$font-weight.bold"; }
    part "calendar.year.month.day:today" { color "$color.accent-fg"; background-color "$color.accent"; border-radius "50%"; }

    // Agenda (view and widget)
    part "calendar.agenda" { overflow-y "auto"; padding "$space.sm" "$space.md"; }
    part "calendar.agenda.date" { margin "$space.md" 0 "$space.xs"; font-size "$font-size.md"; }
    part "calendar.agenda.list" { display "flex"; flex-direction "column"; gap "$space.xxs"; margin 0; padding 0; }
    part "calendar.agenda.event" { display "flex"; gap "$space.sm"; width "100%"; padding "$space.xs"; border 0; border-left "4px solid $color.accent"; text-align "left"; color "$color.fg"; background-color "$color.bg-subtle"; }
    part "calendar.agenda.event.badge" { color "$color.fg-muted"; font-size "$font-size.xs"; }
    part "agenda" { display "flex"; flex-direction "column"; gap "$space.xs"; padding "$space.sm"; }
    part "agenda.title" { margin 0; font-size "$font-size.md"; }
    part "agenda.list.date" { margin "$space.xs" 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "agenda.list.list" { display "flex"; flex-direction "column"; gap "$space.xxs"; margin 0; padding 0; }
    part "agenda.list.event" { display "flex"; flex-wrap "wrap"; gap "$space.xs"; width "100%"; padding "$space.xxs" "$space.xs"; border 0; border-left "3px solid $color.accent"; text-align "left"; color "$color.fg"; background-color "$color.bg-subtle"; }
    part "agenda.list.event.badge" { display "none"; }
    part "agenda.list.empty" { margin 0; color "$color.fg-muted"; }

    // Free time
    part "calendar.free-time" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.md"; overflow-y "auto"; }
    part "calendar.free-time.track" { position "relative"; height 32; border "$border.thin"; border-radius "$radius.sm"; background-color "$color.bg-subtle"; }
    part "calendar.free-time.busy" { position "absolute"; top 0; bottom 0; background-color "$color.bg-raised"; }
    part "calendar.free-time.slot" { position "absolute"; top 2; bottom 2; overflow "hidden"; border "1px solid $color.success"; border-radius "$radius.sm"; font-size "$font-size.xs"; color "$color.fg"; background-color "$color.bg"; white-space "nowrap"; }
    part "calendar.free-time.date" { margin 0; font-size "$font-size.sm"; }

    // Mini-month and the date picker's month
    part "mini-month" { padding "$space.sm"; }
    part "mini-month.header" { display "flex"; align-items "center"; gap "$space.xs"; }
    part "mini-month.title" { flex "1"; margin 0; font-size "$font-size.sm"; text-align "center"; }
    part "mini-month.previous" { border 0; background-color "transparent"; color "$color.fg"; }
    part "mini-month.next" { border 0; background-color "transparent"; color "$color.fg"; }
    part "mini-month.icon" { display "none"; }
    part "mini-month.grid" { width "100%"; border-collapse "collapse"; font-size "$font-size.xs"; }
    part "mini-month.grid.weekday" { font-weight "$font-weight.regular"; color "$color.fg-muted"; }
    part "mini-month.grid.day" { padding "$space.xxs"; text-align "center"; cursor "pointer"; border-radius "$radius.sm"; }
    part "mini-month.grid.day:outside" { color "$color.fg-muted"; }
    part "mini-month.grid.day:busy" { font-weight "$font-weight.bold"; }
    part "mini-month.grid.day:selected" { color "$color.selection-fg"; background-color "$color.selection"; }
    part "mini-month.grid.day:today" { color "$color.accent"; text-decoration "underline"; }
    part "mini-month.grid.day:focus-visible" { outline "2px solid $color.focus-ring"; }

    // Date / time picker
    part "pim.datetime" { position "relative"; display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "pim.datetime.label" { font-size "$font-size.sm"; }
    part "pim.datetime.controls" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.xs"; }
    part "pim.datetime.input" { display "inline-flex"; padding "$space.xs" "$space.sm"; border "$border.control"; border-radius "$radius.sm"; background-color "$color.bg"; color "$color.fg"; }
    part "pim.datetime:invalid" { color "$color.danger"; }
    part "pim.datetime.segment" { padding "0" "1px"; border-radius "$radius.sm"; }
    part "pim.datetime.segment:focus" { color "$color.selection-fg"; background-color "$color.selection"; outline "none"; }
    part "pim.datetime.pick" { padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; background-color "$color.bg-subtle"; color "$color.fg"; }
    part "pim.datetime.pick.icon" { width "$size.icon"; height "$size.icon"; }
    part "pim.datetime.popup" { position "absolute"; top "100%"; z-index 20; padding "$space.sm"; border "$border.thin"; border-radius "$radius.md"; background-color "$color.bg"; box-shadow "$shadow.overlay"; }
    part "pim.datetime.popup.nav" { display "flex"; justify-content "space-between"; }
    part "pim.datetime.popup.icon" { display "none"; }
    part "pim.datetime.month" { border-collapse "collapse"; font-size "$font-size.sm"; }
    part "pim.datetime.month.day" { padding "$space.xs"; text-align "center"; cursor "pointer"; border-radius "$radius.sm"; }
    part "pim.datetime.month.day:outside" { color "$color.fg-muted"; }
    part "pim.datetime.month.day:selected" { color "$color.accent-fg"; background-color "$color.accent"; }
    part "pim.datetime.month.day:focus-visible" { outline "2px solid $color.focus-ring"; }

    // Editors and dialogs
    part "pim.editor" { display "flex"; flex-direction "column"; gap "$space.md"; min-width 360; max-width 720; padding "$space.md"; }
    part "pim.editor.main" { display "flex"; flex-direction "column"; gap "$space.sm"; margin 0; padding 0; border 0; }
    part "pim.editor.when" { display "flex"; flex-direction "column"; gap "$space.sm"; border "$border.thin"; border-radius "$radius.md"; padding "$space.sm"; }
    part "pim.editor.section" { display "flex"; flex-direction "column"; gap "$space.xs"; border "$border.thin"; border-radius "$radius.md"; padding "$space.sm"; }
    part "pim.editor.scope" { display "flex"; flex-wrap "wrap"; gap "$space.md"; border "1px solid $color.accent"; border-radius "$radius.md"; padding "$space.sm"; }
    part "pim.editor.row" { display "flex"; flex-wrap "wrap"; align-items "end"; gap "$space.sm"; }
    part "pim.editor.attendee-list" { display "flex"; flex-direction "column"; gap "$space.xs"; margin 0; padding 0; }
    part "pim.editor.attendee.status" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "pim.editor.suggestions" { display "flex"; flex-wrap "wrap"; gap "$space.xs"; margin 0; padding 0; }
    part "pim.editor.secondary" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "pim.editor.hint" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "pim.editor.read-only" { margin 0; color "$color.warning"; }
    part "pim.editor.actions" { display "flex"; gap "$space.sm"; justify-content "flex-end"; }
    part "pim.editor.photo" { width 96; height 96; border-radius "50%"; }
    part "pim.editor.subtask-list" { margin 0; padding 0; }
    part "pim.editor.subtask" { display "flex"; align-items "center"; gap "$space.sm"; }
    part "pim.recurrence" { display "flex"; flex-direction "column"; gap "$space.xs"; border "$border.thin"; border-radius "$radius.md"; padding "$space.sm"; }
    part "pim.recurrence.weekdays" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; border 0; padding 0; }
    part "pim.recurrence.summary" { margin 0; font-style "italic"; }
    part "pim.scope" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; min-width 320; }
    part "pim.scope.choices" { display "flex"; flex-direction "column"; gap "$space.xs"; border 0; padding 0; }
    part "pim.scope.actions" { display "flex"; gap "$space.sm"; justify-content "flex-end"; }
    part "pim.merge" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; min-width 400; }
    part "pim.merge.groups" { display "flex"; flex-direction "column"; gap "$space.sm"; margin 0; padding 0; }
    part "pim.merge.group" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "pim.merge.group.reasons" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "pim.merge.field" { display "flex"; flex-direction "column"; gap "$space.xxs"; border "$border.thin"; border-radius "$radius.md"; padding "$space.sm"; }
    part "pim.groups" { display "grid"; grid-template-columns "minmax(180px, 240px) minmax(0, 1fr)"; gap "$space.md"; padding "$space.md"; }
    part "pim.groups.items" { margin 0; padding 0; }
    part "pim.groups.choose" { width "100%"; border 0; padding "$space.xs"; text-align "left"; color "$color.fg"; background-color "transparent"; }
    part "pim.groups.choose:selected" { color "$color.selection-fg"; background-color "$color.selection"; }
    part "pim.groups.members" { display "flex"; flex-direction "column"; gap "$space.xxs"; max-height 240; overflow-y "auto"; }
    part "pim.import" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; min-width 360; }
    part "pim.sources" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; min-width 420; }
    part "pim.sources.list" { display "flex"; flex-direction "column"; gap "$space.xs"; margin 0; padding 0; }
    part "pim.sources.item" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "pim.sources.kind" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "pim.sources.state" { font-size "$font-size.xs"; }
    part "pim.sources.item[state=\"error\"]" { color "$color.danger"; }
    part "pim.sources.item[state=\"auth-error\"]" { color "$color.danger"; }
    part "pim.sources.add" { display "flex"; flex-direction "column"; gap "$space.sm"; border "$border.thin"; border-radius "$radius.md"; padding "$space.sm"; }

    // Reminder toasts
    part "pim.toasts" { position "fixed"; left "$space.lg"; bottom "$space.lg"; z-index 900; display "flex"; flex-direction "column"; gap "$space.sm"; max-width 380; }
    part "pim.toasts.list" { display "flex"; flex-direction "column"; gap "$space.sm"; margin 0; padding 0; }
    part "pim.toast" { padding "$space.sm" "$space.md"; border "$border.thin"; border-radius "$radius.md"; color "$color.fg"; background-color "$color.bg"; box-shadow "$shadow.overlay"; }
    part "pim.toast[kind=\"problem\"]" { border-color "$color.danger"; }
    part "pim.toast.title" { margin 0; font-weight "$font-weight.medium"; }
    part "pim.toast.time" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "pim.toast.location" { margin 0; font-size "$font-size.sm"; }
    part "pim.toast.actions" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.xs"; margin-top "$space.xs"; }

    // Calendar list
    part "calendar-list" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.sm"; }
    part "calendar-list.source.name" { margin 0; font-size "$font-size.xs"; color "$color.fg-muted"; text-transform "uppercase"; }
    part "calendar-list.items" { margin 0; padding 0; }
    part "calendar-list.item" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.xs"; }
    part "calendar-list.item:hidden" { color "$color.fg-muted"; }
    part "calendar-list.kind" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "calendar-list.actions" { display "flex"; flex-wrap "wrap"; gap "$space.xs"; }

    // Contacts
    part "contact-list" { display "flex"; flex-direction "column"; gap "$space.sm"; min-height 0; padding "$space.sm"; }
    part "contact-list.toolbar" { display "flex"; flex-wrap "wrap"; align-items "end"; gap "$space.sm"; }
    part "contact-list.actions" { display "flex"; flex-wrap "wrap"; gap "$space.xs"; }
    part "contact-list.count" { margin 0; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "contact-list.items" { flex "1"; overflow-y "auto"; margin 0; padding 0; }
    part "contact-list.item" { display "grid"; grid-template-columns "32px minmax(0, 1fr) auto"; column-gap "$space.sm"; align-items "center"; padding "$space.xs" "$space.sm"; cursor "pointer"; }
    part "contact-list.item:selected" { color "$color.selection-fg"; background-color "$color.selection"; }
    part "contact-list.item:focus-visible" { outline "2px solid $color.focus-ring"; outline-offset -2; }
    part "contact-list.avatar" { grid-row "span 2"; display "flex"; align-items "center"; justify-content "center"; width 32; height 32; border-radius "50%"; font-size "$font-size.xs"; color "$color.accent-fg"; background-color "$color.accent"; }
    part "contact-list.email" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "contact-list.organization" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "contact-list.book" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "contact-list.linked" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "contact-list.item:selected contact-list.email" { color "inherit"; }
    part "contact-list.item:selected contact-list.organization" { color "inherit"; }
    part "contact-list.item:selected contact-list.book" { color "inherit"; }
    part "contact-list.item:selected contact-list.linked" { color "inherit"; }
    part "contact-card" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "contact-card.header" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.md"; }
    part "contact-card.photo" { width 72; height 72; border-radius "50%"; }
    part "contact-card.avatar" { display "flex"; align-items "center"; justify-content "center"; width 72; height 72; border-radius "50%"; font-size "$font-size.xl"; color "$color.accent-fg"; background-color "$color.accent"; }
    part "contact-card.names" { flex "1"; }
    part "contact-card.name" { margin 0; font-size "$font-size.xl"; }
    part "contact-card.organization" { margin 0; color "$color.fg-muted"; }
    part "contact-card.book" { margin 0; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "contact-card.actions" { display "flex"; gap "$space.xs"; }
    part "contact-card.heading" { margin 0 0 "$space.xs"; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "contact-card.values" { display "flex"; flex-direction "column"; gap "$space.xxs"; margin 0; padding 0; }
    part "contact-card.value" { display "flex"; gap "$space.sm"; }
    part "contact-card.kind" { min-width 64; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "contact-card.address" { display "flex"; flex-direction "column"; font-style "normal"; }
    part "contact-card.sync" { padding "$space.sm"; border "1px solid $color.warning"; border-radius "$radius.md"; }
    part "contact-card.term" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "contact-card.detail" { margin 0 0 "$space.xs"; }
    part "contact-card.empty" { color "$color.fg-muted"; }

    // Tasks
    part "task-list" { display "flex"; flex-direction "column"; gap "$space.sm"; min-height 0; padding "$space.sm"; }
    part "task-list.toolbar" { display "flex"; flex-wrap "wrap"; align-items "end"; gap "$space.sm"; }
    part "task-list.add" { display "flex"; flex-wrap "wrap"; align-items "end"; gap "$space.xs"; }
    part "task-list.items" { flex "1"; overflow-y "auto"; margin 0; padding 0; }
    part "task-list.item" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.xs"; padding "$space.xxs" "$space.xs"; }
    part "task-list.item[level=\"2\"]" { padding-left 28; }
    part "task-list.item[level=\"3\"]" { padding-left 48; }
    part "task-list.item:current" { background-color "$color.bg-subtle"; }
    part "task-list.item:focus-visible" { outline "2px solid $color.focus-ring"; outline-offset -2; }
    part "task-list.item:done" { color "$color.fg-muted"; text-decoration "line-through"; }
    part "task-list.title" { flex "1"; border 0; padding 0; text-align "left"; color "inherit"; background-color "transparent"; }
    part "task-list.toggle" { border 0; padding 0; color "inherit"; background-color "transparent"; }
    part "task-list.toggle.icon" { width "$size.icon"; height "$size.icon"; }
    part "task-list.due" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "task-list.due:overdue" { color "$color.danger"; }
    part "task-list.priority" { font-size "$font-size.xs"; }
    part "task-list.priority[priority=\"high\"]" { color "$color.danger"; font-weight "$font-weight.bold"; }
    part "task-list.subtasks" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "task-list.badge" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "task-list.empty" { color "$color.fg-muted"; }

    // ---- Invitations and scheduling (M3b WP84) ----
    part "invitation" { display "flex"; flex-direction "column"; gap "$space.sm"; margin "$space.sm" "$space.md"; padding "$space.md"; border "$border.thin"; border-left "4px solid $color.accent"; border-radius "$radius.md"; background-color "$color.bg-subtle"; }
    part "invitation:cancelled" { border-left "4px solid $color.danger"; }
    part "invitation:outdated" { border-left "4px solid $color.border"; }
    part "invitation:invalid" { border-left "4px solid $color.warning"; }
    part "invitation:error" { border-left "4px solid $color.danger"; }
    part "invitation.header" { display "flex"; flex-wrap "wrap"; align-items "baseline"; gap "$space.sm"; }
    part "invitation.kind" { margin 0; font-size "$font-size.xs"; font-weight "$font-weight.bold"; text-transform "uppercase"; color "$color.accent"; }
    part "invitation.title" { margin 0; font-size "$font-size.lg"; }
    part "invitation.state" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "invitation.state:cancelled" { color "$color.danger"; }
    part "invitation.state:update" { color "$color.accent"; }
    part "invitation.issues" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "invitation.issue" { padding "$space.xs" "$space.sm"; border "1px solid $color.warning"; border-radius "$radius.sm"; color "$color.warning"; }
    part "invitation.issue[severity=\"danger\"]" { border "1px solid $color.danger"; color "$color.danger"; font-weight "$font-weight.bold"; }
    part "invitation.details" { display "grid"; grid-template-columns "max-content 1fr"; column-gap "$space.md"; row-gap "$space.xxs"; }
    part "invitation.detail" { display "contents"; }
    part "invitation.detail.label" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "invitation.status" { margin 0; font-weight "$font-weight.medium"; }
    part "invitation.transport" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "invitation.comment" { margin 0; padding "$space.xs" "$space.sm"; border-left "2px solid $color.border"; }
    part "invitation.comment.label" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "invitation.reply" { margin 0; }
    part "invitation.counter" { display "flex"; flex-direction "column"; gap "$space.xs"; padding "$space.sm"; border "1px solid $color.accent"; border-radius "$radius.md"; }
    part "invitation.counter.intro" { margin 0; font-weight "$font-weight.medium"; }
    part "invitation.attendees.summary" { cursor "pointer"; font-size "$font-size.sm"; }
    part "invitation.attendee-list" { display "flex"; flex-direction "column"; gap "$space.xxs"; padding-top "$space.xs"; }
    part "invitation.attendee" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; font-size "$font-size.sm"; }
    part "invitation.attendee.role" { color "$color.fg-muted"; }
    part "invitation.attendee.status" { color "$color.fg-muted"; }
    part "invitation.conflicts" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "invitation.conflicts.title" { margin 0; font-size "$font-size.sm"; color "$color.warning"; font-weight "$font-weight.medium"; }
    part "invitation.conflicts.none" { margin 0; font-size "$font-size.sm"; color "$color.success"; }
    part "invitation.conflict" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; font-size "$font-size.sm"; }
    part "invitation.conflict:tentative" { color "$color.fg-muted"; font-style "italic"; }
    part "invitation.conflict.time" { color "$color.fg-muted"; }
    part "invitation.actions" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "invitation.done" { margin 0; color "$color.success"; }
    part "scheduling.answer" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "scheduling.answer.buttons" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "scheduling.answer.confirm" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.sm"; border "1px solid $color.accent"; border-radius "$radius.md"; }
    part "scheduling.answer.confirm.text" { margin 0; }
    part "scheduling.propose" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.sm"; border "$border.thin"; border-radius "$radius.md"; }
    part "scheduling.propose.intro" { margin 0; }
    part "scheduling.propose.actions" { display "flex"; gap "$space.sm"; justify-content "flex-end"; }
    part "scheduling.forward" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.sm"; border "$border.thin"; border-radius "$radius.md"; }
    part "scheduling.forward.actions" { display "flex"; gap "$space.sm"; justify-content "flex-end"; }
    part "scheduling.scope" { display "flex"; flex-wrap "wrap"; gap "$space.md"; padding "$space.sm"; border "$border.thin"; border-radius "$radius.md"; }
    part "scheduling.attendees" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.sm"; border "$border.thin"; border-radius "$radius.md"; }

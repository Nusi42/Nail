    part "label-list.new" { border 0; padding "$space.xxs" "$space.xs"; color "$color.accent"; background-color "transparent"; cursor "pointer"; }
    part "label-list.items" { display "flex"; flex-direction "column"; }
    part "label-list.items[depth=\"1\"]" { padding-left "$space.lg"; }
    part "label-list.items[depth=\"2\"]" { padding-left "$space.lg"; }

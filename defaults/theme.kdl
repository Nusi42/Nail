    part "exchange.color:selected" { border "1px solid $color.accent"; }
    part "exchange.color.name" { font-size "$font-size.sm"; }
    part "exchange.mailbox-badge" { padding 0 "$space.xs"; border-radius "$radius.sm"; font-size "$font-size.xs"; color "$color.fg-muted"; background-color "$color.bg-raised"; }
    part "exchange.rule-badges" { gap "$space.xxs"; }
    part "exchange.rule-badge" { padding 0 "$space.xs"; border "$border.thin"; border-radius "$radius.sm"; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "exchange.rule-badge.reasons" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "exchange.task-list-badge" { padding 0 "$space.xs"; border-radius "$radius.sm"; font-size "$font-size.xs"; color "$color.fg-muted"; background-color "$color.bg-raised"; }
    part "exchange.focus-move" { border "$border.thin"; border-radius "$radius.sm"; padding "$space.xxs" "$space.sm"; color "$color.fg"; background-color "transparent"; cursor "pointer"; }
    part "exchange.rooms" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "exchange.rooms.panel" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.sm"; border "$border.thin"; border-radius "$radius.md"; }
    part "exchange.rooms.filters" { display "flex"; flex-wrap "wrap"; align-items "flex-end"; gap "$space.sm"; }
    part "exchange.rooms.items" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "exchange.rooms.empty" { margin 0; color "$color.fg-muted"; }
    part "exchange.rooms.booked" { display "flex"; flex-wrap "wrap"; gap "$space.xs"; }
    part "exchange.rooms.booked.item" { display "flex"; align-items "center"; gap "$space.xxs"; }
    part "exchange.room" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.xs"; padding "$space.xs"; border "$border.thin"; border-radius "$radius.sm"; }
    part "exchange.room.name" { font-weight "$font-weight.medium"; }
    part "exchange.room.capacity" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "exchange.room.place" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "exchange.room.accessible" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "exchange.room.features" { gap "$space.xxs"; }
    part "exchange.room.feature" { padding 0 "$space.xs"; border-radius "$radius.sm"; font-size "$font-size.xs"; background-color "$color.bg-raised"; }
    part "exchange.room.availability" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "exchange.room.busy" { display "flex"; flex-wrap "wrap"; gap "$space.xxs"; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "exchange.room.response" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "exchange.oof" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "exchange.oof.schedule" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; border 0; padding 0; }
    part "exchange.oof.sync" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "exchange.setup.type" { display "flex"; flex-direction "column"; gap "$space.xs"; border 0; padding 0; }
    part "exchange.setup.review" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "exchange.setup.title" { margin 0; font-size "$font-size.md"; font-weight "$font-weight.medium"; }
    part "exchange.setup.details" { display "grid"; grid-template-columns "max-content 1fr"; gap "$space.xxs" "$space.sm"; margin 0; }
    part "exchange.setup.term" { color "$color.fg-muted"; }
    part "exchange.setup.value" { margin 0; overflow-wrap "anywhere"; }
    part "exchange.setup.warning" { margin 0; color "$color.warning"; }
    part "exchange.setup.redirect" { display "flex"; flex-direction "column"; gap "$space.xs"; padding "$space.sm"; border "1px solid $color.warning"; border-radius "$radius.sm"; }
    part "exchange.setup.sign-in" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "exchange.status" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "exchange.status.details" { display "grid"; grid-template-columns "max-content 1fr"; gap "$space.xxs" "$space.sm"; margin 0; }
    part "exchange.status.term" { color "$color.fg-muted"; }
    part "exchange.status.value" { margin 0; }
    part "exchange.status.warnings" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "exchange.status.warning" { color "$color.warning"; }
    part "exchange.dialog" { display "flex"; flex-direction "column"; gap "$space.md"; min-width 360; max-width 640; padding "$space.md"; }
    part "exchange.intro" { margin 0; }
    part "exchange.question" { margin 0; font-weight "$font-weight.medium"; }
    part "exchange.notice" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "exchange.actions" { display "flex"; gap "$space.sm"; justify-content "flex-end"; }
    part "exchange.problem" { margin 0; color "$color.danger"; }
    part "exchange.hint" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }

    // ---- Confirmations of AI agents and plug-ins, plug-in extensions (ADRs 0083, 0084) ----

    part "confirmation-center" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "confirmation-center.intro" { margin 0; color "$color.fg-muted"; }
    part "confirmation-center.views" { gap "$space.xs"; }
    part "confirmation-center.view:selected" { font-weight "$font-weight.bold"; }
    part "confirmation-center.list" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "confirmation-center.empty" { color "$color.fg-muted"; }
    part "confirmation-center.error" { color "$color.danger"; }
    part "confirmation" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
        background-color "$color.bg"
    }
    part "confirmation[risk=\"destructive\"]" { border-color "$color.danger"; }
    part "confirmation[risk=\"outgoing\"]" { border-color "$color.warning"; }
    part "confirmation.header" { gap "$space.sm"; }
    part "confirmation.actor" { font-weight "$font-weight.bold"; }
    part "confirmation.on-behalf-of" { color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "confirmation.kind" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "confirmation.risk" { font-size "$font-size.sm"; font-weight "$font-weight.bold"; }
    part "confirmation[risk=\"destructive\"] confirmation.risk" { color "$color.danger"; }
    part "confirmation[risk=\"outgoing\"] confirmation.risk" { color "$color.warning"; }
    part "confirmation.summary" { margin 0; font-size "$font-size.md"; }
    part "confirmation.targets.title" { margin 0; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "confirmation.targets.list" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "confirmation.target.kind" { font-size "$font-size.xs"; color "$color.fg-muted"; margin-right "$space.xs"; }
    part "confirmation.targets.more" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "confirmation.changes" { font-size "$font-size.sm"; }
    part "confirmation.changes.caption" { text-align "left"; color "$color.fg-muted"; }
    part "confirmation.change.field" { padding "$space.xxs" "$space.sm"; color "$color.fg-muted"; text-align "left"; }
    part "confirmation.change.before" { padding "$space.xxs" "$space.sm"; text-decoration "line-through"; color "$color.fg-muted"; }
    part "confirmation.change.after" { padding "$space.xxs" "$space.sm"; }
    part "confirmation.times" { gap "$space.md"; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "confirmation.accounts" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "confirmation.operation" { font-family "$font.mono"; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "confirmation.buttons" { gap "$space.sm"; }
    part "confirmation.always-allow" { display "flex"; align-items "center"; gap "$space.xs"; }
    part "confirmation.always-asks" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "confirmation.outcome" { gap "$space.sm"; font-size "$font-size.sm"; }
    part "confirmation.state" { font-weight "$font-weight.medium"; }
    part "confirmation.error" { color "$color.danger"; }
    part "confirmation-notices.list" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "confirmation-notice" {
        gap "$space.sm"
        padding "$space.sm" "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
        background-color "$color.bg-raised"
        box-shadow "$shadow.overlay"
    }
    part "confirmation-notice[risk=\"destructive\"]" { border-color "$color.danger"; }
    part "confirmation-notice[risk=\"outgoing\"]" { border-color "$color.warning"; }
    part "confirmation-notice.actor" { font-weight "$font-weight.bold"; }
    part "confirmation-notice.summary" { font-size "$font-size.sm"; }
    part "confirmation-indicator" { gap "$space.xs"; padding "$space.xxs" "$space.sm"; }
    part "confirmation-indicator:waiting" { color "$color.accent-fg"; background-color "$color.accent"; border-radius "$radius.sm"; }
    part "confirmation-indicator.count" { font-weight "$font-weight.bold"; }
    part "action-policies" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "action-policies.title" { margin 0; font-size "$font-size.md"; }
    part "action-policies.intro" { margin 0; color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "action-policies.list" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "action-policies.item" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "action-policies.kind" { flex "1 1 200px"; }
    part "action-policies.choice" { display "flex"; gap "$space.sm"; }
    part "action-policies.locked" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "action-policies.default" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "action-policies.error" { color "$color.danger"; }

    part "plugin-banners" { display "flex"; flex-direction "column"; gap "$space.xs"; padding "$space.xs" "$space.md"; }
    part "plugin-banner" {
        display "flex"
        flex-wrap "wrap"
        align-items "center"
        gap "$space.sm"
        padding "$space.sm" "$space.md"
        border-left "3px solid $color.accent"
        border-radius "$radius.sm"
        background-color "$color.bg-subtle"
    }
    part "plugin-banner[level=\"warning\"]" { border-left-color "$color.warning"; }
    part "plugin-banner[level=\"error\"]" { border-left-color "$color.danger"; }
    part "plugin-banner[level=\"success\"]" { border-left-color "$color.success"; }
    part "plugin-banner.plugin" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "plugin-banner.text" { flex "1 1 auto"; }
    part "plugin-banner.buttons" { display "flex"; gap "$space.xs"; }
    part "plugin-banner.error" { color "$color.danger"; }
    part "plugin-badges" { display "flex"; flex-wrap "wrap"; gap "$space.xs"; }
    part "plugin-badge" { padding "0" "$space.xs"; border "$border.thin"; border-radius "$radius.sm"; font-size "$font-size.xs"; }
    part "plugin-badge[level=\"warning\"]" { color "$color.warning"; border-color "$color.warning"; }
    part "plugin-badge[level=\"error\"]" { color "$color.danger"; border-color "$color.danger"; }
    part "plugin-badge[level=\"success\"]" { color "$color.success"; border-color "$color.success"; }
    part "plugin-preview" { display "flex"; flex-direction "column"; gap "$space.xs"; margin "$space.sm" "$space.md"; padding "$space.sm"; border "$border.thin"; border-radius "$radius.md"; max-height 480; overflow "auto"; }
    part "plugin-preview.header" { display "flex"; flex-wrap "wrap"; align-items "center"; justify-content "space-between"; gap "$space.sm"; }
    part "plugin-preview.by" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "plugin-preview.loading" { color "$color.fg-muted"; }
    part "plugin-preview.error" { color "$color.danger"; }
    part "plugin-extension-menu" { position "relative"; display "inline-flex"; }
    part "plugin-extension-menu.list" {
        position "absolute"
        z-index 50
        min-width 220
        margin 0
        padding "$space.xs"
        border "$border.thin"
        border-radius "$radius.md"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "plugin-extension-menu.title" { padding "$space.xxs" "$space.sm"; font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "plugin-extension-menu.item" { display "flex"; flex-direction "column"; width "100%"; padding "$space.xs" "$space.sm"; border 0; border-radius "$radius.sm"; text-align "left"; background-color "transparent"; color "inherit"; cursor "pointer"; }
    part "plugin-extension-menu.item:focus" { background-color "$color.selection"; color "$color.selection-fg"; }
    part "plugin-extension-menu.plugin" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "plugin-actions.error" { color "$color.danger"; font-size "$font-size.sm"; }
    part "plugin-composer" { display "inline-flex"; flex-wrap "wrap"; align-items "center"; gap "$space.xs"; }
    part "plugin-composer.edited" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "plugin-composer.error" { color "$color.danger"; font-size "$font-size.sm"; }
    part "composer.plugin-blocks" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "plugin-block" { margin 0; padding "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; }
    part "plugin-block.caption" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "plugin-block.source" { font-family "$font.mono"; font-size "$font-size.sm"; white-space "pre-wrap"; }
    part "plugin-veto.backdrop" { position "fixed"; inset 0; z-index 400; background-color "$color.scrim"; }
    part "plugin-veto" {
        position "fixed"
        z-index 401
        inset 0
        width "min(520px, calc(100% - 32px))"
        height "fit-content"
        margin "auto"
        display "flex"
        flex-direction "column"
        gap "$space.md"
        padding "$space.lg"
        border "$border.thin"
        border-radius "$radius.lg"
        background-color "$color.bg"
        box-shadow "$shadow.overlay"
    }
    part "plugin-veto.title" { margin 0; font-size "$font-size.lg"; }
    part "plugin-veto.intro" { margin 0; color "$color.fg-muted"; }
    part "plugin-veto.list" { display "flex"; flex-direction "column"; gap "$space.sm"; margin 0; padding 0; }
    part "plugin-veto.plugin" { font-weight "$font-weight.bold"; }
    part "plugin-veto.reason" { margin 0; }
    part "plugin-veto.buttons" { display "flex"; justify-content "flex-end"; gap "$space.sm"; }
    part "plugin-veto.error" { color "$color.danger"; }
    part "plugin-activity" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "plugin-activity.heading" { margin 0; font-size "$font-size.md"; }
    part "plugin-activity.cpu" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "plugin-activity.cpu[level=\"high\"] plugin-activity.cpu.value" { color "$color.warning"; }
    part "plugin-activity.cpu[level=\"exhausted\"] plugin-activity.cpu.value" { color "$color.danger"; }
    part "plugin-activity.cpu.exhausted" { color "$color.danger"; font-size "$font-size.sm"; }
    part "plugin-activity.hooks" { font-size "$font-size.sm"; border-collapse "collapse"; }
    part "plugin-activity.caption" { text-align "left"; color "$color.fg-muted"; }
    part "plugin-activity.job-list" { display "flex"; flex-direction "column"; gap "$space.xs"; margin 0; padding 0; }
    part "plugin-activity.job" { padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; }
    part "plugin-activity.job[state=\"error\"]" { border-color "$color.danger"; }
    part "plugin-activity.job[state=\"running\"]" { border-color "$color.accent"; }
    part "plugin-activity.job.title" { font-weight "$font-weight.medium"; }
    part "plugin-activity.job.facts" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "plugin-activity.schedule" { font-family "$font.mono"; }
    part "plugin-activity.last-error" { color "$color.danger"; font-size "$font-size.sm"; }
    part "plugin-activity.none" { color "$color.fg-muted"; }
    part "plugin-activity.error" { color "$color.danger"; }
    part "plugin-permissions.item[write]" { font-weight "$font-weight.medium"; }
    part "mcp-grants.scope[write]" { font-weight "$font-weight.medium"; }
    part "mcp-rate-limits" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "mcp-rate-limits.title" { margin 0; font-size "$font-size.md"; }
    part "mcp-rate-limits.intro" { margin 0; color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "mcp-rate-limits.fields" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "mcp-rate-limits.limit" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "mcp-rate-limits.issue" { color "$color.danger"; font-size "$font-size.sm"; }
    part "mcp-rate-limits.actions" { display "flex"; gap "$space.sm"; }
    part "mcp-clients.pending" { color "$color.warning"; }

    // ---- The desktop app: updates, About, tray and startup, default apps, first run (ADRs 0091, 0092) ----

    part "update-settings" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "update-settings.title" { margin 0; font-size "$font-size.lg"; }
    part "update-settings.installation" { margin 0; color "$color.fg-muted"; font-size "$font-size.sm"; }
    part "update-settings.error" { color "$color.danger"; }
    part "update-status" {
        display "flex"
        flex-direction "column"
        gap "$space.sm"
        padding "$space.md"
        border "$border.thin"
        border-radius "$radius.md"
        background-color "$color.bg"
    }
    part "update-status[state=\"available\"]" { border-color "$color.accent"; }
    part "update-status[state=\"ready-to-install\"]" { border-color "$color.success"; }
    part "update-status[state=\"failed\"]" { border-color "$color.danger"; }
    part "update-status.text" { margin 0; }
    part "update-status.text[tone=\"policy\"]" { color "$color.fg-muted"; }
    part "update-status.progress.text" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "update-status.checked" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "update-status.buttons" { gap "$space.sm"; }
    part "update-status.error" { color "$color.danger"; font-size "$font-size.sm"; }
    part "release-notes" { display "flex"; flex-direction "column"; gap "$space.xs"; max-height 320; overflow-y "auto"; font-size "$font-size.sm"; }
    part "release-notes.heading" { margin 0; font-size "$font-size.md"; }
    part "release-notes.text" { margin 0; }
    part "release-notes.list" { margin 0; padding-left "$space.lg"; }

    part "about-nail" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "about-nail.title" { margin 0; font-size "$font-size.xl"; }
    part "about-nail.tagline" { margin 0; color "$color.fg-muted"; }
    part "about-nail.facts" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "about-nail.fact" { gap "$space.sm"; }
    part "about-nail.fact.label" { color "$color.fg-muted"; }
    part "about-nail.fact.value" { font-weight "$font-weight.medium"; }
    part "about-nail.section.title" { margin 0; font-size "$font-size.md"; }
    part "about-nail.updates" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "about-nail.unavailable" { color "$color.fg-muted"; }

    part "desktop-settings" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.md"; overflow-y "auto"; }
    part "desktop-settings.title" { margin 0; font-size "$font-size.lg"; }
    part "desktop-settings.endpoint" { font-family "$font.mono"; font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "desktop-settings.error" { color "$color.danger"; }

    part "default-apps" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "default-apps.title" { margin 0; font-size "$font-size.lg"; }
    part "default-apps.intro" { margin 0; color "$color.fg-muted"; }
    part "default-apps.list" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "default-apps.item" { gap "$space.sm"; padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; }
    part "default-apps.item.state" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "default-apps.item[state=\"default\"] default-apps.item.state" { color "$color.success"; }
    part "default-apps.item[state=\"unregistered\"] default-apps.item.state" { color "$color.warning"; }
    part "default-apps.buttons" { gap "$space.sm"; }
    part "default-apps.opened" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "default-apps.unregistered" { color "$color.warning"; }
    part "default-apps.error" { color "$color.danger"; }

    part "first-run" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.lg"; overflow-y "auto"; }
    part "first-run.title" { margin 0; font-size "$font-size.xl"; }
    part "first-run.intro" { margin 0; color "$color.fg-muted"; }
    part "first-run.steps" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "first-run.step" { display "flex"; flex-direction "column"; gap "$space.xs"; padding "$space.md"; border "$border.thin"; border-radius "$radius.md"; }
    part "first-run.step.title" { margin 0; font-size "$font-size.md"; }
    part "first-run.step.text" { margin 0; }
    part "first-run.step.state" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "first-run.later" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "first-run.buttons" { gap "$space.sm"; justify-content "flex-end"; }
    part "first-run.error" { color "$color.danger"; }

    part "program-draft" {
        gap "$space.sm"
        padding "$space.sm" "$space.md"
        border-left "3px solid $color.accent"
        border-radius "$radius.sm"
        background-color "$color.bg-subtle"
    }
    part "program-draft.text" { margin 0; }

    // ---- M4c: command palette, printing, import / export / backup, diagnostics, recovery key, smartcards (ADRs 0094, 0098) ----

    // The command palette (Ctrl+K): an overlay with a search field and a list of actions.
    part "palette" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.md"; min-height 0; }
    part "palette.search" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "palette.input" {
        padding "$space.sm" "$space.md"
        font-size "$font-size.lg"
        border "$border.control"
        border-radius "$radius.md"
        background-color "$color.bg"
        color "$color.fg"
    }
    part "palette.input:focus-visible" { outline "2px solid $color.focus-ring"; outline-offset 1; }
    part "palette.status" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "palette.list" { display "flex"; flex-direction "column"; gap "$space.xxs"; margin 0; padding 0; max-height 420; overflow-y "auto"; }
    part "palette.item" {
        display "flex"
        align-items "center"
        gap "$space.sm"
        padding "$space.xs" "$space.sm"
        border-radius "$radius.sm"
        cursor "pointer"
    }
    part "palette.item:hover" { background-color "$color.bg-subtle"; }
    part "palette.item[state=\"active\"]" { background-color "$color.selection"; color "$color.selection-fg"; }
    part "palette.item[state=\"unavailable\"]" { opacity "$opacity.muted"; }
    part "palette.item[state=\"recent\"] palette.item.badge" { color "$color.accent"; }
    part "palette.item.title" { flex-grow 1; }
    part "palette.item.badge" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "palette.item.unavailable" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "palette.shortcuts" { display "flex"; gap "$space.xxs"; }
    part "palette.shortcut" {
        padding "0" "$space.xs"
        font-family "$font.mono"
        font-size "$font-size.xs"
        border "$border.thin"
        border-radius "$radius.sm"
        background-color "$color.bg-subtle"
    }
    part "palette.match" { font-weight "$font-weight.bold"; text-decoration "underline"; }
    part "palette.empty" { color "$color.fg-muted"; padding "$space.sm"; }
    part "palette.footer" { display "flex"; flex-wrap "wrap"; justify-content "space-between"; gap "$space.sm"; }
    part "palette.hint" { font-size "$font-size.xs"; color "$color.fg-muted"; }

    // The print dialog and the print view (#/print/<job>; the `print` colour mode applies while it shows).
    part "print-setup" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "print-setup.what" { margin 0; font-weight "$font-weight.medium"; }
    part "print-setup.nothing" { color "$color.fg-muted"; }
    part "print-setup.saved" { color "$color.success"; }
    part "print" { background-color "$color.bg"; color "$color.fg"; font-family "$font.reader"; }
    part "print.toolbar" { display "flex"; gap "$space.sm"; padding "$space.sm"; border-bottom "$border.thin"; }
    part "print.page" { display "flex"; flex-direction "column"; gap "$space.lg"; padding "$space.lg"; max-width 800; margin "0 auto"; }
    part "print.message" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "print.subject" { margin 0; font-size "$font-size.xl"; }
    part "print.headers" { display "grid"; grid-template-columns "max-content 1fr"; gap "$space.xxs $space.md"; margin 0; font-size "$font-size.sm"; }
    part "print.header" { display "contents"; }
    part "print.header.name" { font-weight "$font-weight.bold"; }
    part "print.header.value" { margin 0; }
    part "print.body" { border-top "$border.thin"; padding-top "$space.sm"; }
    part "print.text" { margin 0; white-space "pre-wrap"; overflow-wrap "anywhere"; font-family "$font.reader"; }
    part "print.quote" { margin 0; padding-left "$space.sm"; border-left "3px solid $color.border"; color "$color.fg-muted"; white-space "pre-wrap"; }
    part "print.quote-omitted" { font-style "italic"; color "$color.fg-muted"; }
    part "print.attachments" { font-size "$font-size.sm"; }
    part "print.attachments.list" { margin 0; padding-left "$space.lg"; }
    part "print.attachment" { overflow-wrap "anywhere"; }
    part "print.thread" { display "flex"; flex-direction "column"; gap "$space.lg"; }
    part "print.thread.title" { margin 0; font-size "$font-size.xl"; }
    part "print.thread.count" { color "$color.fg-muted"; }
    part "print.event" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "print.event.title" { margin 0; font-size "$font-size.xl"; }
    part "print.attendees" { font-size "$font-size.sm"; }
    part "print.attendees.list" { margin 0; padding-left "$space.lg"; }
    part "print.attendee" { overflow-wrap "anywhere"; }
    part "print.section.title" { margin 0; font-size "$font-size.md"; }
    part "print.agenda" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "print.agenda.heading" { margin 0; font-size "$font-size.xl"; }
    part "print.agenda.group" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "print.agenda.day" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "print.agenda.date" { margin 0; font-size "$font-size.md"; border-bottom "$border.thin"; }
    part "print.agenda.events" { margin 0; padding 0; display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "print.agenda.event" { display "flex"; gap "$space.sm"; }
    part "print.agenda.time" { min-width 96; font-variant-numeric "tabular-nums"; color "$color.fg-muted"; }
    part "print.agenda.title" { font-weight "$font-weight.medium"; }
    part "print.agenda.location" { color "$color.fg-muted"; }
    part "print.agenda.free" { color "$color.fg-muted"; font-style "italic"; }
    part "print.agenda.month" { width "100%"; border-collapse "collapse"; font-size "$font-size.xs"; }
    part "print.agenda.caption" { text-align "left"; font-size "$font-size.md"; font-weight "$font-weight.bold"; }
    part "print.agenda.week-row" { vertical-align "top"; }
    part "print.agenda.cell" { border "$border.thin"; padding "$space.xxs"; height 72; overflow "hidden"; }
    part "print.agenda.cell.day" { font-weight "$font-weight.bold"; }
    part "print.error" { color "$color.danger"; }
    part "print.recovery-kit" { display "flex"; flex-direction "column"; gap "$space.md"; }

    // Wizards (import, export, backup, restore), path fields, jobs and reports.
    part "wizard" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "wizard.header" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "wizard.step" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "wizard.title" { margin 0; font-size "$font-size.lg"; }
    part "wizard.intro" { margin 0; color "$color.fg-muted"; }
    part "wizard.step-body" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "wizard.buttons" { display "flex"; flex-wrap "wrap"; justify-content "flex-end"; gap "$space.sm"; }
    part "path-field" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "form.radio" { display "flex"; align-items "center"; gap "$space.xs"; }
    part "portability.choices" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "portability.choice" { display "flex"; align-items "flex-start"; gap "$space.sm"; padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; }
    part "portability.buttons" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }
    part "portability.count" { font-variant-numeric "tabular-nums"; }
    part "portability.loading" { color "$color.fg-muted"; }
    part "portability.section.title" { margin 0; font-size "$font-size.md"; }
    part "portability.found" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "portability.found.item" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "portability.found.label" { font-weight "$font-weight.medium"; }
    part "portability.found.default" { font-size "$font-size.xs"; color "$color.accent"; }
    part "portability.found.used" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "portability.issues" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "portability.issues.count" { font-weight "$font-weight.medium"; }
    part "portability.issues.list" { display "flex"; flex-direction "column"; gap "$space.xs"; max-height 280; overflow-y "auto"; }
    part "portability.issue" { padding "$space.xs" "$space.sm"; border-left "3px solid $color.border"; }
    part "portability.issue[severity=\"warning\"]" { border-left-color "$color.warning"; }
    part "portability.issue[severity=\"skipped\"]" { border-left-color "$color.danger"; }
    part "portability.issue.severity" { font-size "$font-size.xs"; font-weight "$font-weight.bold"; }
    part "portability.issue.text" { margin 0; }
    part "portability.issue.where" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "portability.issue.path" { font-family "$font.mono"; overflow-wrap "anywhere"; }
    part "portability.issue.details" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "portability.issue.detail" { font-family "$font.mono"; overflow-wrap "anywhere"; }
    part "portability.report" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "portability.report[state=\"completed\"] portability.report.title" { color "$color.success"; }
    part "portability.report[state=\"completed-with-issues\"] portability.report.title" { color "$color.warning"; }
    part "portability.report[state=\"failed\"] portability.report.title" { color "$color.danger"; }
    part "portability.report.heading" { display "flex"; flex-direction "column"; gap "$space.xxs"; }
    part "portability.report.title" { margin 0; font-size "$font-size.md"; }
    part "portability.report.path" { font-family "$font.mono"; font-size "$font-size.sm"; overflow-wrap "anywhere"; }
    part "portability.report.when" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "portability.progress" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "portability.progress.bar" { width "100%"; accent-color "$color.accent"; }
    part "portability.progress.phase" { font-weight "$font-weight.medium"; }
    part "portability.progress.current" { font-size "$font-size.sm"; color "$color.fg-muted"; overflow-wrap "anywhere"; }
    part "portability.jobs" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "portability.jobs.list" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "portability.job" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; }
    part "portability.job[state=\"running\"]" { border-color "$color.accent"; }
    part "portability.job[state=\"failed\"]" { border-color "$color.danger"; }
    part "portability.job.kind" { font-weight "$font-weight.medium"; }
    part "portability.job.path" { font-family "$font.mono"; font-size "$font-size.xs"; overflow-wrap "anywhere"; }
    part "portability.job.when" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "portability.manifest" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "portability.manifest.items" { margin 0; padding-left "$space.lg"; }
    part "portability.manifest.created" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "portability.plan" { width "100%"; border-collapse "collapse"; font-size "$font-size.sm"; }
    part "portability.plan.caption" { text-align "left"; font-weight "$font-weight.medium"; padding-bottom "$space.xs"; }
    part "portability.plan.head" { text-align "left"; border-bottom "$border.thin"; padding "$space.xxs" "$space.sm"; }
    part "portability.plan.item" { padding "$space.xxs" "$space.sm"; }
    part "portability.plan.effect" { padding "$space.xxs" "$space.sm"; font-weight "$font-weight.medium"; }
    part "portability.plan.numbers" { padding "$space.xxs" "$space.sm"; font-variant-numeric "tabular-nums"; }
    part "portability.plan.note" { font-size "$font-size.sm"; color "$color.fg-muted"; }
    part "portability.proposals" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "portability.proposal-list" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "portability.proposal" { padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; }
    part "portability.proposal[state=\"incomplete\"]" { border-color "$color.warning"; }
    part "portability.proposal[state=\"added\"]" { border-color "$color.success"; }
    part "portability.verify" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "import-export" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "backup-restore" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }

    // The diagnostics bundle: options, the exact preview, the saved file.
    part "diagnostics-settings" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "diagnostics" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "diagnostics.issues" { color "$color.danger"; font-size "$font-size.sm"; }
    part "diagnostics.preview" { display "flex"; flex-direction "column"; gap "$space.xs"; }
    part "diagnostics.preview.summary" { font-weight "$font-weight.medium"; }
    part "diagnostics.entries" { display "flex"; flex-direction "column"; gap "$space.xs"; margin 0; padding 0; }
    part "diagnostics.entry" { padding "$space.xs" "$space.sm"; border "$border.thin"; border-radius "$radius.sm"; }
    part "diagnostics.entry.summary" { cursor "pointer"; }
    part "diagnostics.entry.name" { font-family "$font.mono"; }
    part "diagnostics.entry.item" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "diagnostics.entry.size" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "diagnostics.entry.redactions" { margin 0; padding-left "$space.lg"; font-size "$font-size.xs"; }
    part "diagnostics.entry.redaction" { color "$color.fg-muted"; }
    part "diagnostics.entry.text" { margin 0; max-height 240; overflow "auto"; font-family "$font.mono"; font-size "$font-size.xs"; white-space "pre-wrap"; background-color "$color.bg-subtle"; padding "$space.xs"; }
    part "diagnostics.saved" { display "flex"; flex-direction "column"; gap "$space.xxs"; color "$color.success"; }
    part "diagnostics.saved.text" { margin 0; }
    part "diagnostics.saved.hash" { font-family "$font.mono"; font-size "$font-size.xs"; overflow-wrap "anywhere"; color "$color.fg-muted"; }

    // The vault recovery key: create (shown once), check, restore.
    part "recovery" { display "flex"; flex-direction "column"; gap "$space.md"; }
    part "recovery.text" { margin 0; }
    part "recovery.result" { font-weight "$font-weight.medium"; }
    part "recovery-key" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.md"; border "2px dashed $color.border"; border-radius "$radius.md"; }
    part "recovery-key.value" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; font-family "$font.mono"; font-size "$font-size.lg"; }
    part "recovery-key.group" { font-family "$font.mono"; letter-spacing "0.05em"; }
    part "recovery-settings" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "recovery-settings.facts" { display "flex"; flex-direction "column"; gap "$space.xxs"; margin 0; }
    part "recovery-settings.fact" { display "flex"; gap "$space.sm"; }
    part "recovery-settings.fact.label" { color "$color.fg-muted"; }
    part "recovery-settings.fact.value" { margin 0; font-weight "$font-weight.medium"; }
    part "recovery-settings.confirm" { display "flex"; flex-wrap "wrap"; gap "$space.sm"; }

    // Smartcards (PKCS#11): modules, cards, keys and certificates; the PIN prompt.
    part "smartcards" { display "flex"; flex-direction "column"; gap "$space.md"; padding "$space.md"; overflow-y "auto"; }
    part "smartcards.modules" { display "flex"; flex-direction "column"; gap "$space.xs"; margin 0; padding 0; }
    part "smartcards.module" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; }
    part "smartcards.module.path" { font-family "$font.mono"; font-size "$font-size.sm"; overflow-wrap "anywhere"; }
    part "smartcards.tokens" { display "flex"; flex-direction "column"; gap "$space.sm"; margin 0; padding 0; }
    part "smartcards.token" { display "flex"; flex-direction "column"; gap "$space.xs"; padding "$space.sm"; border "$border.thin"; border-radius "$radius.md"; }
    part "smartcards.token.label" { margin 0; font-size "$font-size.md"; }
    part "smartcards.token.facts" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "smartcards.objects" { display "flex"; flex-direction "column"; gap "$space.xs"; margin 0; padding 0; }
    part "smartcards.object" { display "flex"; flex-wrap "wrap"; align-items "center"; gap "$space.sm"; padding "$space.xs"; border-top "$border.thin"; }
    part "smartcards.object.kind" { font-size "$font-size.xs"; font-weight "$font-weight.bold"; }
    part "smartcards.object.label" { font-weight "$font-weight.medium"; }
    part "smartcards.object.algorithm" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "smartcards.object.usages" { font-size "$font-size.xs"; color "$color.fg-muted"; }
    part "smartcards.object.certificate" { font-size "$font-size.xs"; }
    part "smartcards.object.fingerprint" { font-family "$font.mono"; font-size "$font-size.xs"; overflow-wrap "anywhere"; }
    part "smartcards.object.used" { font-size "$font-size.xs"; color "$color.success"; }
    part "smartcards.object.actions" { display "flex"; gap "$space.xs"; }
    part "pin-prompt" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "pin-prompt.purpose" { margin 0; font-weight "$font-weight.medium"; }
    part "pin-prompt.token" { margin 0; color "$color.fg-muted"; }
    part "pin-prompt.key" { margin 0; font-family "$font.mono"; font-size "$font-size.sm"; }
    part "pin-prompt.text" { margin 0; }
}

    part "exchange-categories.view" { display "flex"; flex "1"; align-items "center"; gap "$space.xs"; min-width 0; border 0; padding "$space.xxs" "$space.xs"; text-align "left"; color "inherit"; background-color "transparent"; cursor "pointer"; }
    part "exchange-categories.view:focus-visible" { outline "2px solid $color.focus-ring"; outline-offset -2; }
    part "exchange-categories.name" { flex "1"; overflow "hidden"; text-overflow "ellipsis"; white-space "nowrap"; }

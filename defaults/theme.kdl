    // Free/busy timeline
    part "freebusy" { display "flex"; flex-direction "column"; gap "$space.sm"; }
    part "freebusy-timeline" { display "flex"; flex-direction "column"; gap "$space.sm"; padding "$space.sm"; min-height 0; overflow "auto"; }

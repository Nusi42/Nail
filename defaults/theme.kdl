    part "label-list.view" { display "flex"; flex "1"; align-items "center"; gap "$space.xs"; min-width 0; border 0; padding "$space.xxs" "$space.xs"; text-align "left"; color "inherit"; background-color "transparent"; cursor "pointer"; }

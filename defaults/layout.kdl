// Nail default layout: the three-pane mail window and its secondary windows.
//
// Your own layout.kdl can start with `layout "My layout" extends="default" { ... }`
// and override only what you want to change. See userDocs/en/layout-reference.md.

layout "default" {
    // Wide windows: folders | message list | reader, with a toolbar on top and
    // a status bar at the bottom.
    breakpoint min-width=900 {
        window "main" {
            stack id="root" sizes="auto auto 1fr auto auto auto" {
                toolbar id="main-toolbar" label="@toolbar.main" toolbar="main"
                // Every error of every config file; nothing while all are valid.
                config-errors id="config-errors" hide-when-valid=#true
                split "horizontal" id="panes" \
                    sizes="240px 1fr 1.4fr" \
                    min-sizes="160px 280px 320px" \
                    max-sizes="480px none none" \
                    collapsible="true false true" {
                    stack id="sidebar" label="@layout.pane.folders" sizes="auto auto 1fr auto auto auto auto" {
                        search-bar id="search" scope="account"
                        account-switcher id="accounts"
                        folder-tree id="folders" show-unread=#true
                        // Gmail accounts: labels as views (nothing for other accounts).
                        label-list id="gmail-labels"
                        // Exchange accounts: shared / delegate mailboxes and the
                        // master category list (nothing for other accounts).
                        exchange-mailboxes id="exchange-mailboxes"
                        exchange-categories id="exchange-categories"
                        smart-folders id="smart-folders" label="@saved-search-label"
                    }
                    stack id="list-pane" label="@layout.pane.messages" sizes="auto auto auto 1fr" {
                        // While automatic replies (out of office) of an Exchange
                        // account are on: a banner with Turn off / Edit.
                        automatic-replies-banner id="automatic-replies"
                        // Gmail inbox categories (nothing for other accounts).
                        category-tabs id="gmail-categories"
                        // Exchange Focused Inbox tabs (nothing for other accounts).
                        focused-tabs id="exchange-focused"
                        message-list id="list" page-size=100 {
                            row "{from.name}  {date | relative}"
                            row "{subject}"
                            row "{preview}"
                        }
                    }
                    stack id="reader" label="@layout.pane.message" sizes="auto auto auto auto auto auto auto 1fr" {
                        toolbar id="reader-toolbar" toolbar="reader"
                        thread-view id="thread" expand="none"
                        // Signature / encryption and sender check badges, then
                        // warnings about deceptive links and risky attachments.
                        security-message id="message-security"
                        security-warnings id="message-warnings"
                        // Remote images stay blocked until you allow them.
                        remote-content id="message-remote-content"
                        // Junk verdict with "Not junk"; a body that is not
                        // stored yet with "Download full message".
                        junk-verdict id="message-junk"
                        sync-message-body id="message-body-status"
                        message-view id="message" headers="from to cc date"
                    }
                }
                status-bar id="status" items="sync-progress account-status ops send-status folder-counts"
                // Shown while an AI agent reads what you are looking at.
                mcp-context-indicator id="agent-indicator"
                // How many changes by AI agents or plug-ins wait for your
                // approval (nothing while none waits); opens the confirmations.
                confirmation-indicator id="confirmation-indicator"
            }
        }
    }

    // Narrow windows (phones, small browser windows): one pane at a time.
    breakpoint max-width=899 {
        window "main" {
            stack id="root" sizes="auto auto auto 1fr auto auto auto" {
                toolbar id="main-toolbar" label="@toolbar.main" toolbar="main"
                config-errors id="config-errors" hide-when-valid=#true
                search-bar id="search" scope="account"
                tabs id="panes" active=1 {
                    stack id="sidebar" label="@layout.pane.folders" sizes="auto 1fr auto auto auto auto" {
                        account-switcher id="accounts"
                        folder-tree id="folders" show-unread=#true
                        label-list id="gmail-labels"
                        exchange-mailboxes id="exchange-mailboxes"
                        exchange-categories id="exchange-categories"
                        smart-folders id="smart-folders" label="@saved-search-label"
                    }
                    stack id="list-pane" label="@layout.pane.messages" sizes="auto auto auto 1fr" {
                        automatic-replies-banner id="automatic-replies"
                        category-tabs id="gmail-categories"
                        focused-tabs id="exchange-focused"
                        message-list id="list" page-size=100 {
                            row "{from.name}  {date | relative}"
                            row "{subject}"
                        }
                    }
                    stack id="reader" label="@layout.pane.message" sizes="auto auto auto auto auto auto auto 1fr" {
                        toolbar id="reader-toolbar" toolbar="reader"
                        thread-view id="thread" expand="none"
                        security-message id="message-security"
                        security-warnings id="message-warnings"
                        remote-content id="message-remote-content"
                        junk-verdict id="message-junk"
                        sync-message-body id="message-body-status"
                        message-view id="message" headers="from date"
                    }
                }
                status-bar id="status" items="sync-progress ops send-status"
                mcp-context-indicator id="agent-indicator"
                confirmation-indicator id="confirmation-indicator"
            }
        }
    }

    // Secondary windows, opened over the main window.
    window "composer" {
        stack id="composer-stack" sizes="1fr auto" {
            composer id="composer"
            // Sign and Encrypt with the key status of every recipient.
            security-composer id="composer-security"
        }
    }
    window "outbox" {
        outbox id="outbox"
    }
    window "move" {
        folder-picker id="move-picker"
    }
    window "account-setup" {
        account-setup id="account-setup"
    }
    window "rules" {
        rule-manager id="rules"
    }
    // Snoozed messages, with "Wake up now".
    window "snoozed" {
        snooze-list id="snoozed"
    }
    // Calendars, contacts and tasks (M3a; userDocs/en/calendar-contacts-tasks.md).
    window "calendar" {
        stack id="calendar-root" sizes="auto 1fr" {
            toolbar id="calendar-toolbar" label="@pim.toolbar.calendar" toolbar="calendar"
            split "horizontal" id="calendar-panes" sizes="260px 1fr" min-sizes="200px 480px" collapsible="true false" {
                stack id="calendar-sidebar" label="@pim.pane.calendars" sizes="auto auto 1fr" {
                    mini-month id="calendar-mini-month"
                    calendar-list id="calendar-list"
                    task-list id="calendar-tasks" sort="due"
                }
                calendar id="calendar-main" view="week" views="day work-week week month year agenda free-time" scroll-to=8
            }
        }
    }
    window "contacts" {
        split "horizontal" id="contacts-panes" sizes="360px 1fr" {
            contact-list id="contacts-list" label="@pim.pane.contacts"
            contact-card id="contacts-card" label="@pim.pane.contact"
        }
    }
    window "tasks" {
        task-list id="tasks"
    }
    window "settings" {
        tabs id="settings-tabs" {
            account-settings id="account-settings" label="@settings.tab.accounts"
            // Themes, Follow Windows, density, text size, corner radius and accent (M5a).
            appearance-settings id="appearance" label="@settings.tab.appearance"
            virtual-account-editor id="virtual-accounts" label="@settings.tab.virtual-accounts"
            mcp-clients id="mcp-clients" label="@mcp.settings.tab"
            // Changes by AI agents and plug-ins that wait for you, and the history.
            confirmation-center id="confirmation-center" label="@agents.center.tab"
            security-keys id="security-keys" label="@security.settings.tab.keys"
            security-identities id="security-identities" label="@security.settings.tab.identities"
            security-settings id="security-settings" label="@security.settings.tab.protection"
            security-autocrypt id="security-autocrypt" label="@security.settings.tab.autocrypt"
            // The vault recovery key and smartcards (PKCS#11) for signing / decrypting (M4c).
            security-recovery-key id="security-recovery-key" label="@security.settings.tab.recovery-key"
            security-smartcards id="security-smartcards" label="@security.settings.tab.smartcards"
            remote-settings id="remote-settings" label="@remote.settings.tab"
            remote-users id="remote-users" label="@remote.settings.tab.users"
            remote-devices id="remote-devices" label="@remote.settings.tab.devices"
            remote-audit id="remote-audit" label="@remote.settings.tab.audit"
            remote-content-allows id="remote-content-allows" label="@remote.settings.tab.privacy"
            // Server-side rules (Sieve) and the vacation reply.
            sieve-status id="sieve-status" label="@sieve.settings.tab"
            // Exchange accounts: Nail rules placed as inbox rules, the server's rules.
            exchange-rules id="exchange-rules" label="@exchange.settings.tab.rules"
            vacation-editor id="vacation" label="@vacation.settings.tab"
            junk-settings id="junk-settings" label="@junk.settings.tab"
            notification-settings id="notification-settings" label="@notification.settings.tab"
            // What each folder downloads (full, headers only, recent days).
            sync-folder-policies id="sync-policies" label="@sync.settings.tab"
            // Installed plug-ins: on / off, permissions, settings, logs, placements.
            plugin-manager id="plugin-manager" label="@plugin.manager.tab"
            // The desktop app (Windows): updates and the installation, tray and
            // startup, default apps. In a browser they say "desktop app only".
            update-settings id="update-settings" label="@system.settings.tab.updates"
            desktop-settings id="desktop-settings" label="@system.settings.tab.desktop"
            default-apps id="default-apps" label="@system.settings.tab.default-apps"
            // Import / export, backups and the diagnostics bundle (M4c).
            import-export id="import-export" label="@portability.settings.tab.import-export"
            backup-restore id="backup-restore" label="@portability.settings.tab.backup"
            diagnostics id="diagnostics" label="@portability.settings.tab.diagnostics"
            stack id="customize" label="@settings.tab.customize" sizes="auto auto 1fr" {
                toolbar id="customize-toolbar" label="@toolbar.customize" toolbar="customize"
                config-errors id="settings-config-errors"
                // Toolbars, shortcuts and list columns, written into this file.
                tabs id="customize-editors" label="@customize.editors.tabs" {
                    toolbar-editor id="toolbar-editor" label="@customize.toolbar.tab"
                    key-binding-editor id="key-binding-editor" label="@customize.keys.tab"
                    column-editor id="column-editor" label="@customize.columns.tab"
                }
            }
        }
    }

    // Icons are Lucide names (https://lucide.dev, M5a): "reply-all",
    // "square-pen", … A theme's `icons` can replace any of them by name.
    actions {
        action "mail.next"        label="@mail.action.next" icon="chevron-down"
        action "mail.previous"    label="@mail.action.previous" icon="chevron-up"
        action "mail.compose"     label="@mail.action.compose"     icon="square-pen"
        action "mail.reply"       label="@mail.action.reply"       icon="reply"
        action "mail.reply-all"   label="@mail.action.reply-all"   icon="reply-all"
        action "mail.forward"     label="@mail.action.forward"     icon="forward"
        action "mail.archive"     label="@mail.action.archive"     icon="archive"
        action "mail.move"        label="@mail.action.move"        icon="folder-input"
        action "mail.move-to"     label="@mail.action.move-to"     icon="folder-input"
        action "mail.delete"      label="@mail.action.delete"      icon="trash"
        action "mail.delete-permanently" label="@mail.action.delete-permanently" icon="trash"
        action "mail.toggle-read" label="@mail.action.toggle-read" icon="mail-open"
        action "mail.toggle-flag" label="@mail.action.toggle-flag" icon="flag"
        action "composer.send"    label="@composer.action.send"    icon="send"
        action "composer.save"    label="@composer.action.save" icon="save"
        action "composer.discard" label="@composer.action.discard" icon="trash"
        action "composer.set-mode" label="@composer.action.set-mode" icon="type"
        action "composer.toggle-preview" label="@composer.action.toggle-preview" icon="eye"
        action "composer.toggle-source" label="@composer.action.toggle-source" icon="code"
        action "composer.attach"  label="@composer.action.attach"  icon="paperclip"
        action "outbox.undo"      label="@outbox.action.undo" icon="undo-2"
        action "outbox.open"      label="@outbox.action.open"      icon="send-horizontal" alias-of="window.open" "outbox"
        action "search.focus"     label="@search.action.focus"     icon="search"
        action "search.clear"     label="@search.action.clear" icon="x"
        action "account.add"      label="@account.action.add"      icon="user-plus"
        action "settings.open"    label="@settings.action.open"    icon="settings" alias-of="window.open" "settings"
        action "window.open"      label="@window.action.open" icon="external-link"
        action "window.close"     label="@window.action.close"     icon="x"
        action "view.toggle"      label="@view.action.toggle" icon="layout-panel-left"
        action "sync.now"         label="@sync.action.now"         icon="refresh-cw"
        action "rules.open"       label="@rules.action.open"       icon="funnel"
        action "rules.create-from-message" label="@rules.action.create-from-message" icon="funnel"
        action "mcp.indicator.dismiss" label="@mcp.indicator.dismiss" icon="x"
        action "inspector.toggle" label="@customize.action.inspector" icon="scan-search"
        action "customize.merge"  label="@customize.action.merge" icon="git-merge"
        action "customize.errors" label="@customize.action.errors" icon="circle-alert"
        action "security.autocrypt.import" label="@security.action.autocrypt-import" icon="key-round"
        action "remote.pair"      label="@remote.action.pair" icon="smartphone"
        action "remote.content.allow" label="@remote.action.load-content" icon="image"
        action "remote.logout"    label="@remote.action.logout" icon="log-out"
        action "menu.context"     label="@context-menu.action.open" icon="ellipsis-vertical"
        action "junk.mark"        label="@junk.action.mark"        icon="shield-alert"
        action "junk.not-junk"    label="@junk.action.not-junk"    icon="inbox"
        action "snooze.open"      label="@snooze.action.open"      icon="alarm-clock"
        action "snooze.list"      label="@snooze.action.list"      icon="alarm-clock"
        action "sync.download-message" label="@sync.action.download-message" icon="download"
        action "sync.folder-policy" label="@sync.action.folder-policy" icon="refresh-cw"
        action "plugins.manage"   label="@plugin.action.manage" icon="puzzle"
        action "plugins.install"  label="@plugin.action.install" icon="package-plus"
        action "plugins.load-dev" label="@plugin.action.load-dev" icon="code"
        // Calendars, contacts and tasks (M3a).
        action "pim.calendar.open" label="@pim.action.open-calendar" icon="calendar" alias-of="window.open" "calendar"
        action "pim.contacts.open" label="@pim.action.open-contacts" icon="book-user" alias-of="window.open" "contacts"
        action "pim.tasks.open"   label="@pim.action.open-tasks" icon="list-checks"   alias-of="window.open" "tasks"
        action "calendar.goto-today" label="@pim.action.calendar-today" icon="calendar-check"
        action "calendar.next"    label="@pim.action.calendar-next" icon="chevron-right"
        action "calendar.previous" label="@pim.action.calendar-previous" icon="chevron-left"
        action "calendar.view"    label="@pim.action.calendar-view" icon="calendar-range"
        action "calendar.new-event" label="@pim.action.new-event"  icon="plus"
        action "calendar.event-from-message" label="@pim.action.event-from-message" icon="calendar"
        action "calendar.calendars" label="@pim.action.sources" icon="layers"
        action "tasks.new"        label="@pim.action.new-task" icon="list-plus"
        action "tasks.from-message" label="@pim.action.task-from-message" icon="square-check-big"
        action "contacts.new"     label="@pim.action.new-contact" icon="user-plus"
        action "contacts.groups"  label="@pim.action.contact-groups" icon="users"
        action "contacts.merge"   label="@pim.action.merge-contacts" icon="git-merge"
        action "pim.import"       label="@pim.action.import" icon="import"
        action "pim.sources"      label="@pim.action.sources" icon="layers"
        action "pim.sync"         label="@pim.action.sync"         icon="refresh-cw"
        // Invitations, scheduling and Gmail labels (M3b).
        action "scheduling.accept" label="@scheduling.action.accept" icon="check"
        action "scheduling.tentative" label="@scheduling.action.tentative" icon="circle-question-mark"
        action "scheduling.decline" label="@scheduling.action.decline" icon="x"
        action "scheduling.find-time" label="@scheduling.action.find-time" icon="calendar"
        action "scheduling.settings" label="@scheduling.action.settings" icon="settings"
        action "gmail.new-label"  label="@gmail.action.new-label"  icon="plus"
        action "gmail.apply-labels" label="@gmail.action.apply-labels" icon="tags"
        action "gmail.label-view" label="@gmail.action.label-view" icon="tag"
        action "gmail.category"   label="@gmail.action.category" icon="inbox"
        // Exchange accounts (M3c).
        action "exchange.automatic-replies" label="@exchange.action.automatic-replies" icon="plane"
        action "exchange.add-mailbox" label="@exchange.action.add-mailbox" icon="plus"
        action "exchange.new-category" label="@exchange.action.new-category" icon="plus"
        action "exchange.focus"   label="@exchange.action.focus" icon="focus"
        action "exchange.classify" label="@exchange.action.classify" icon="list-filter"
        action "exchange.toggle-focused" label="@exchange.action.toggle-focused" icon="arrow-left-right"
        action "exchange.apply-categories" label="@exchange.action.apply-categories" icon="tags"
        // The desktop app (M4b): About Nail, check for updates, the welcome
        // screen, Windows Settings → Default apps.
        action "system.about"     label="@system.action.about" icon="info"
        action "system.check-updates" label="@system.action.check-updates" icon="refresh-cw"
        action "system.first-run" label="@system.action.first-run" icon="sparkles"
        action "system.default-apps" label="@system.action.default-apps" icon="app-window"
        // The command palette, printing, import / export / backup,
        // diagnostics (M4c).
        action "palette.open"     label="@palette.action.open"     icon="search"
        action "print.message"    label="@print.action.message" icon="printer"
        action "print.thread"     label="@print.action.thread" icon="printer"
        action "print.event"      label="@print.action.event" icon="printer"
        action "print.agenda"     label="@print.action.agenda" icon="printer"
        action "print.save-pdf"   label="@print.action.save-pdf" icon="file-down"
        action "import.open"      label="@portability.action.import" icon="import"
        action "export.open"      label="@portability.action.export" icon="upload"
        action "backup.create"    label="@portability.action.backup" icon="hard-drive-download"
        action "backup.restore"   label="@portability.action.restore" icon="hard-drive-upload"
        action "diagnostics.open" label="@portability.action.diagnostics" icon="stethoscope"
        action "agents.open-center" label="@agents.action.open-center" icon="bot"
    }

    keys context="list" {
        bind "j" "mail.next"
        bind "k" "mail.previous"
        bind "arrowdown" "mail.next"
        bind "arrowup" "mail.previous"
        bind "ctrl+p" "print.message"
    }

    keys context="reader" {
        bind "j" "mail.next"
        bind "k" "mail.previous"
        bind "shift+y" "scheduling.accept"
        bind "shift+m" "scheduling.tentative"
        bind "shift+n" "scheduling.decline"
        bind "shift+o" "exchange.classify"
        bind "ctrl+p" "print.message"
    }

    keys context="composer" {
        bind "ctrl+enter" "composer.send"
        bind "ctrl+s" "composer.save"
        bind "ctrl+shift+a" "composer.attach"
    }

    keys context="search" {
        bind "escape" "search.clear"
    }

    keys context="calendar" {
        bind "t" "calendar.goto-today"
        bind "n" "calendar.next"
        bind "p" "calendar.previous"
        bind "d" "calendar.view \"day\""
        bind "w" "calendar.view \"week\""
        bind "m" "calendar.view \"month\""
        bind "y" "calendar.view \"year\""
        bind "a" "calendar.view \"agenda\""
        bind "c" "calendar.new-event"
    }

    keys context="window" {
        bind "escape" "window.close"
        // The command palette also opens (and closes) over dialogs.
        bind "ctrl+k" "palette.open"
        bind "ctrl+shift+p" "palette.open"
    }

    keys {
        bind "c" "mail.compose"
        bind "r" "mail.reply"
        bind "a" "mail.reply-all"
        bind "f" "mail.forward"
        bind "e" "mail.archive"
        bind "v" "mail.move"
        bind "delete" "mail.delete"
        bind "shift+delete" "mail.delete-permanently"
        bind "u" "mail.toggle-read"
        bind "s" "mail.toggle-flag"
        bind "/" "search.focus"
        bind "f5" "sync.now"
        bind "ctrl+b" "view.toggle \"sidebar\""
        bind "g r" "view.toggle \"reader\""
        bind "g o" "outbox.open"
        bind "g c" "pim.calendar.open"
        bind "g p" "pim.contacts.open"
        bind "g t" "pim.tasks.open"
        bind "g a" "agents.open-center"
        bind "ctrl+," "settings.open"
        bind "ctrl+shift+i" "inspector.toggle"
        bind "f1" "system.about"
        bind "b" "snooze.open"
        bind "shift+j" "junk.mark"
        // The command palette (M4c): every action, searchable.
        bind "ctrl+k" "palette.open"
        bind "ctrl+shift+p" "palette.open"
        // The context menu of the focused item (list row, folder, message).
        bind "shift+f10" "menu.context"
        bind "contextmenu" "menu.context"
    }

    toolbar "main" {
        item "mail.compose"
        item "sync.now"
        separator
        item "outbox.open"
        item "rules.open"
        item "snooze.list"
        separator
        item "pim.calendar.open"
        item "pim.contacts.open"
        item "pim.tasks.open"
        spacer
        item "account.add"
        item "settings.open"
    }

    toolbar "reader" {
        item "mail.reply"
        item "mail.reply-all"
        item "mail.forward"
        spacer
        item "mail.archive"
        item "mail.move"
        item "mail.delete"
        separator
        item "mail.toggle-read"
        item "mail.toggle-flag"
        item "snooze.open"
        item "junk.mark"
        item "rules.create-from-message"
        item "calendar.event-from-message"
        item "tasks.from-message"
        item "gmail.apply-labels"
        item "exchange.apply-categories"
        item "exchange.classify"
        item "security.autocrypt.import"
        item "print.message"
    }

    // The calendar window's toolbar (M3a).
    toolbar "calendar" {
        item "pim.sync"
        separator
        item "tasks.new"
        item "contacts.new"
        item "scheduling.find-time"
        spacer
        item "print.event"
        item "print.agenda"
        item "pim.import"
        item "pim.sources"
        item "scheduling.settings"
    }

    toolbar "customize" {
        item "customize.merge"
        item "customize.errors"
        item "inspector.toggle"
    }

    // Right-click menus (also Shift+F10 and the menu key), per part.
    menu "context:message-list.row" {
        item "mail.reply"
        item "mail.reply-all"
        item "mail.forward"
        separator
        item "mail.toggle-read"
        item "mail.toggle-flag"
        item "snooze.open"
        separator
        item "mail.archive"
        item "mail.move"
        item "mail.delete"
        separator
        item "junk.mark"
        item "junk.not-junk"
        item "sync.download-message"
        separator
        item "rules.create-from-message"
        item "calendar.event-from-message"
        item "tasks.from-message"
        item "gmail.apply-labels"
        item "exchange.apply-categories"
        item "exchange.classify"
        separator
        item "print.message"
        item "print.thread"
    }

    menu "context:thread-view.message" {
        item "mail.reply"
        item "mail.reply-all"
        item "mail.forward"
        separator
        item "mail.toggle-read"
        item "mail.toggle-flag"
    }

    menu "context:message-view" {
        item "mail.reply"
        item "mail.reply-all"
        item "mail.forward"
        separator
        item "snooze.open"
        item "junk.mark"
        item "junk.not-junk"
        item "sync.download-message"
        separator
        item "print.message"
        item "print.save-pdf"
    }

    menu "context:folder-tree.folder" {
        item "sync.now"
        item "sync.folder-policy"
        item "gmail.new-label"
        item "exchange.add-mailbox"
        item "exchange.new-category"
    }
}

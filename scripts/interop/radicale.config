# Radicale 3 for Nail's CalDAV / CardDAV interop tests (plan M3a WP72).
# Used by start-servers.sh (Docker, image tomsquest/docker-radicale): the
# config is mounted at /config/config, the users file at /config/users,
# the certificates from gen-certs.sh at /certs. Radicale is a test
# server only; it is not shipped or linked with Nail.
#
# User: ada@example.org / nail-interop (radicale.users, plain text: test
# data only). Every user owns the collections under /<user>/.

[server]
hosts = 0.0.0.0:5232
ssl = True
certificate = /certs/server.pem
key = /certs/server.key

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = plain
delay = 0

[rights]
type = owner_only

[storage]
filesystem_folder = /data/collections

[logging]
level = info

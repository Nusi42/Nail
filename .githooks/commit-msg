#!/bin/sh
# The commit message rules (scripts/check-commit-msg.mjs, ADR 0200), then no
# private data in the message or the identity (scripts/check-private.mjs,
# ADR 0192; the patterns stay outside the repository). Never bypass with
# --no-verify.
node "$(dirname "$0")/../scripts/check-commit-msg.mjs" "$1" || exit 1
exec node "$(dirname "$0")/../scripts/check-private.mjs" --message "$1"

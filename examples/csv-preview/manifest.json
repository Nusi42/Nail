{
  "id": "csv-preview",
  "name": "%plugin-name%",
  "version": "1.0.0",
  "apiVersion": "1",
  "main": "dist/index.js",
  "description": "%plugin-description%",
  "author": "Nail",
  "permissions": ["attachments"],
  "contributes": {
    "attachmentPreviews": [
      {
        "id": "table",
        "title": "%preview-title%",
        "mimeTypes": ["text/csv", "text/tab-separated-values", "application/csv"],
        "extensions": ["csv", "tsv"],
        "maxBytes": 2097152
      }
    ],
    "settings": [
      {
        "type": "boolean",
        "key": "header-row",
        "title": "%setting-header-title%",
        "description": "%setting-header-description%",
        "default": true
      },
      {
        "type": "number",
        "key": "max-rows",
        "title": "%setting-rows-title%",
        "description": "%setting-rows-description%",
        "default": 200,
        "min": 1,
        "max": 499
      }
    ],
    "locales": { "en": "locales/en.ftl" }
  }
}

# Texte des Beispiels „Anhang-Prüfung“ auf Deutsch: die `%id%`-Verweise
# des Manifests und die Texte des Codes (`nail.l10n.t`).

plugin-name = Anhang-Prüfung
plugin-description = Hält eine Nachricht an, die einen Anhang erwähnt, aber keinen hat. Senden können Sie trotzdem immer.
setting-keywords-title = Weitere Wörter für einen Anhang
setting-keywords-description = Durch Kommas getrennt. Ein * am Ende passt auf jedes Wort, das so beginnt (Bericht*).
setting-quoted-title = Auch zitierten Text prüfen
setting-quoted-description = In Antworten auch die zitierte Nachricht prüfen (Zeilen, die mit „>“ beginnen).

# Die Wörter für „es gibt einen Anhang“, durch Kommas getrennt. Ein * am
# Ende passt auf jedes Wort, das so beginnt.
attachment-keywords = anhang*, anhäng*, angehängt*, anbei, beigefügt*, beiliegend*, im Anhang

# $keyword = das Wort, wie es in der Nachricht steht.
veto-reason = Sie erwähnen „{ $keyword }“, aber es ist nichts angehängt. Hängen Sie die Datei an oder senden Sie die Nachricht trotzdem.

{
  "id": "follow-up",
  "name": "%plugin-name%",
  "version": "1.0.0",
  "apiVersion": "1",
  "main": "dist/index.js",
  "description": "%plugin-description%",
  "author": "Nail",
  "permissions": ["mail.read", "ui.dialogs", "storage", "notifications"],
  "contributes": {
    "commands": [
      {
        "id": "follow-up",
        "title": "%follow-up-title%",
        "description": "%follow-up-description%",
        "icon": "flag",
        "contexts": ["list", "reader"]
      }
    ],
    "placements": [{ "toolbar": "reader", "after": "mail.forward", "command": "follow-up" }],
    "keys": [{ "key": "shift+f", "command": "follow-up", "context": "list" }],
    "panels": [{ "id": "due", "title": "%due-title%", "icon": "flag" }],
    "settings": [
      {
        "type": "number",
        "key": "default-days",
        "title": "%setting-days-title%",
        "description": "%setting-days-description%",
        "default": 1,
        "min": 0,
        "max": 365
      }
    ],
    "locales": { "en": "locales/en.ftl" }
  }
}

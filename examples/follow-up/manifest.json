{
  "id": "follow-up",
  "name": "%plugin-name%",
  "version": "2.0.0",
  "apiVersion": "1",
  "main": "dist/index.js",
  "description": "%plugin-description%",
  "author": "Nail",
  "permissions": [
    "mail.read",
    "tasks.write",
    "ui.dialogs",
    "notifications",
    "storage",
    "background"
  ],
  "contributes": {
    "commands": [
      {
        "id": "follow-up",
        "title": "%follow-up-title%",
        "description": "%follow-up-description%",
        "icon": "flag",
        "contexts": ["list", "reader"]
      }
    ],
    "placements": [{ "toolbar": "reader", "after": "mail.forward", "command": "follow-up" }],
    "keys": [{ "key": "shift+f", "command": "follow-up", "context": "list" }],
    "panels": [{ "id": "due", "title": "%due-title%", "icon": "flag" }],
    "jobs": [
      {
        "id": "remind",
        "title": "%remind-title%",
        "schedule": "@hourly",
        "events": ["app.started"]
      }
    ],
    "settings": [
      {
        "type": "number",
        "key": "default-days",
        "title": "%setting-days-title%",
        "description": "%setting-days-description%",
        "default": 1,
        "min": 0,
        "max": 365
      },
      {
        "type": "boolean",
        "key": "remind",
        "title": "%setting-remind-title%",
        "description": "%setting-remind-description%",
        "default": true
      }
    ],
    "locales": { "en": "locales/en.ftl" }
  }
}

# Normalize line endings: LF in the repository and working tree on every OS.
* text=auto eol=lf
# Embedded with include_str! (defaults, goldens, catalogs): a CR in the working
# copy changes what the binaries and tests see, so never check them out as CRLF.
*.kdl text eol=lf
*.ftl text eol=lf
*.png binary
*.ico binary
*.icns binary
# Golden MIME files are compared byte for byte (CRLF line endings).
crates/nail-compose/tests/golden/*.eml -text
# End-to-end test vectors (M2a): signed MIME must stay byte-exact.
crates/nail-testkit/corpus/crypto/**/*.eml -text
*.p12 binary
*.pfx binary
*.der binary
*.gpg binary
*.pgp binary

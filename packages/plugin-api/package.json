{
  "name": "@nail/plugin-api",
  "private": true,
  "version": "0.8.1",
  "description": "Types, the nail API, the JSX runtime, the test host and packaging tools for Nail plug-ins",
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./testing": "./src/testing.ts",
    "./globals": {
      "types": "./src/globals.d.ts"
    },
    "./tools": {
      "types": "./tools/index.d.mts",
      "default": "./tools/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nail-plugin": "./tools/cli.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 . && npm run typecheck && prettier --check .",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check",
    "typecheck": "tsc -p . && tsc -p tsconfig.sandbox.json"
  },
  "peerDependencies": {
    "esbuild": ">=0.25"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}

{
  "id": "__PLUGIN_ID__",
  "name": "__PLUGIN_NAME__",
  "version": "0.1.0",
  "apiVersion": "1",
  "main": "dist/index.js",
  "description": "%plugin-description%",
  "permissions": ["composer"],
  "contributes": {
    "composerActions": [
      { "id": "insert-date", "title": "%insert-date-title%", "icon": "calendar" },
      {
        "id": "upper-case",
        "title": "%upper-case-title%",
        "description": "%upper-case-description%"
      }
    ],
    "markdownBlocks": [
      { "id": "callout", "title": "%callout-title%", "template": "Something worth noticing." }
    ],
    "locales": { "en": "locales/en.ftl" }
  }
}

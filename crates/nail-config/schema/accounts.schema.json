{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nail accounts.kdl",
  "description": "An `accounts.kdl` file.",
  "type": "object",
  "properties": {
    "account": {
      "description": "`account \"<name>\" email=… { … }`: real accounts, in display order.\nNames: lowercase letters, digits, `-`, `_`, `.`; `all` is reserved.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/AccountSchema"
      }
    },
    "caldav": {
      "description": "`caldav \"<name>\" account=… url=… { auth … }`: CalDAV servers\n(calendars and task lists).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DavSourceSchema"
      }
    },
    "calendar-subscription": {
      "description": "`calendar-subscription \"<name>\" url=… { auth … }`: read-only ICS /\nwebcal calendar subscriptions. Names: like account names, unique\namong calendar and contact sources; `local` is reserved.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/CalendarSubscriptionSchema"
      }
    },
    "carddav": {
      "description": "`carddav \"<name>\" account=… url=… { auth … }`: CardDAV servers\n(address books).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/DavSourceSchema"
      }
    },
    "oauth-provider": {
      "description": "`oauth-provider \"<id>\" client-id=… { scopes … }`: OAuth2 client\nregistrations. `google` and `microsoft` are built in and need only\n`client-id`.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/OAuthProviderSchema"
      }
    },
    "undo-send-delay": {
      "description": "`undo-send-delay <seconds>`: default delay before a sent message\nreally leaves (0 to 600, default 10).",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 600,
      "minimum": 0
    },
    "virtual-account": {
      "description": "`virtual-account \"<name>\" { members … }`: several accounts shown as\none.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/VirtualAccountSchema"
      }
    }
  },
  "$defs": {
    "AccountSchema": {
      "description": "`account \"<name>\" name=… email=… enabled=… save-sent-copy=… { … }`.",
      "type": "object",
      "properties": {
        "authserv-id": {
          "description": "`authserv-id \"mx.example.net\" …`: the ids your receiving servers\nwrite into `Authentication-Results`; only their results are shown\n(default: learned from recent mail).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "email": {
          "description": "Primary email address.",
          "type": "string"
        },
        "enabled": {
          "description": "`#false` stops syncing without removing the account (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "exchange": {
          "description": "`exchange engine=\"graph\"|\"ews\" … { auth … }`: Microsoft Exchange\n(M3c; mail, calendars, contacts and tasks; sends through Exchange,\nso no `smtp`).",
          "anyOf": [
            {
              "$ref": "#/$defs/ExchangeSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "gmail": {
          "description": "`gmail { auth \"oauth2\" provider=\"google\" }`: the Gmail API (M3b;\nsends through the API, so no `smtp`).",
          "anyOf": [
            {
              "$ref": "#/$defs/GmailSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "description": "`identity \"<address>\" … { bcc …; signature … }`: sending identities,\nthe first is the default (default: one for `email`).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/IdentitySchema"
          }
        },
        "imap": {
          "description": "`imap host=… { auth … }`: IMAP incoming server (exactly one of imap\nand pop3).",
          "anyOf": [
            {
              "$ref": "#/$defs/ImapSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Display name (default: the account name).",
          "type": [
            "string",
            "null"
          ]
        },
        "pop3": {
          "description": "`pop3 host=… { auth … }`: POP3 incoming server.",
          "anyOf": [
            {
              "$ref": "#/$defs/Pop3Schema"
            },
            {
              "type": "null"
            }
          ]
        },
        "save-sent-copy": {
          "description": "Append sent mail to the Sent folder (default: automatic).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "sieve": {
          "description": "`sieve host=… port=… tls=… script=… enabled=…`: ManageSieve for\nserver-side rules and vacation replies (IMAP accounts only; the\nlogin is the IMAP login).",
          "anyOf": [
            {
              "$ref": "#/$defs/SieveSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "smtp": {
          "description": "`smtp host=… { auth … }`: outgoing server.",
          "anyOf": [
            {
              "$ref": "#/$defs/SmtpSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "sync": {
          "description": "`sync bodies=… { folder … }`: what to synchronize.",
          "anyOf": [
            {
              "$ref": "#/$defs/SyncSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "email"
      ]
    },
    "AuthSchema": {
      "description": "`auth \"<method>\" …`.",
      "oneOf": [
        {
          "description": "`auth \"password\" username=… secret=… mechanism=…`.",
          "type": "object",
          "properties": {
            "mechanism": {
              "description": "plain, login, scram-sha-256, or apop (POP3).",
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": "string",
              "const": "password"
            },
            "secret": {
              "description": "Keychain reference (default `keychain:nail/<account>/password`).",
              "anyOf": [
                {
                  "$ref": "#/$defs/SecretRefSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "username": {
              "description": "Login name (default: the account email).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "description": "`auth \"oauth2\" provider=… username=… secret=… mechanism=…`.",
          "type": "object",
          "properties": {
            "mechanism": {
              "description": "xoauth2 or oauthbearer.",
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": "string",
              "const": "oauth2"
            },
            "provider": {
              "description": "google, microsoft or an oauth-provider id.",
              "type": "string"
            },
            "secret": {
              "description": "Keychain reference of the refresh token (default\n`keychain:nail/<account>/oauth2`).",
              "anyOf": [
                {
                  "$ref": "#/$defs/SecretRefSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "username": {
              "description": "Login name (default: the account email).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "method",
            "provider"
          ]
        },
        {
          "description": "`auth \"client-certificate\" username=… secret=…`.",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "client-certificate"
            },
            "secret": {
              "description": "Keychain reference of the PEM certificate and key (default\n`keychain:nail/<account>/client-certificate`).",
              "anyOf": [
                {
                  "$ref": "#/$defs/SecretRefSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "username": {
              "description": "Authorization identity, if needed.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "description": "`auth \"windows\" username=… secret=… package=…`: Windows sign-in\n(Exchange only; Negotiate / Kerberos / NTLM through SSPI).",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "windows"
            },
            "package": {
              "description": "negotiate (default), kerberos or ntlm.",
              "type": [
                "string",
                "null"
              ]
            },
            "secret": {
              "description": "Keychain reference of the password of `username` (default\n`keychain:nail/<account>/password`).",
              "anyOf": [
                {
                  "$ref": "#/$defs/SecretRefSchema"
                },
                {
                  "type": "null"
                }
              ]
            },
            "username": {
              "description": "`DOMAIN\\user` or `user@domain` (default: the signed-in Windows\nuser, no secret).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "method"
          ]
        },
        {
          "description": "`auth \"none\"`.",
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "method"
          ]
        }
      ]
    },
    "BodiesSchema": {
      "description": "What to download. Not applied yet: this version always downloads whole\nmessages.",
      "oneOf": [
        {
          "description": "Whole messages.",
          "type": "string",
          "const": "full"
        },
        {
          "description": "Headers; bodies on demand (not applied yet).",
          "type": "string",
          "const": "headers-only"
        },
        {
          "description": "Whole messages of the last `days` days (not applied yet).",
          "type": "string",
          "const": "recent"
        }
      ]
    },
    "CalendarSubscriptionSchema": {
      "description": "`calendar-subscription \"<name>\" name=… url=… color=… alarms=… refresh=… enabled=… { auth … }`.",
      "type": "object",
      "properties": {
        "alarms": {
          "description": "Fire the feed's own reminders (default #false).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "auth": {
          "description": "Login for protected feeds (no `username` default).",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "color": {
          "description": "Colour: #RGB, #RRGGBB, #RRGGBBAA or a CSS colour name.",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "description": "`#false` stops refreshing without removing the calendar (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "name": {
          "description": "Display name (default: the calendar name of the feed).",
          "type": [
            "string",
            "null"
          ]
        },
        "refresh": {
          "description": "Refresh interval in minutes, 5 to 10080 (default: the feed's\nsuggestion, else 360).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 10080,
          "minimum": 5
        },
        "url": {
          "description": "The feed: https:, webcal: or webcals: (http: only for localhost).",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "ComposerSchema": {
      "description": "Composer mode.",
      "oneOf": [
        {
          "description": "Plain text.",
          "type": "string",
          "const": "plain"
        },
        {
          "description": "HTML.",
          "type": "string",
          "const": "html"
        },
        {
          "description": "Markdown.",
          "type": "string",
          "const": "markdown"
        }
      ]
    },
    "CryptoSchema": {
      "description": "`crypto technology=… sign=… encrypt=… openpgp-key=… smime-cert=…\nautocrypt=… prefer-encrypt=… protect-headers=…`.",
      "type": "object",
      "properties": {
        "autocrypt": {
          "description": "Send Autocrypt headers and learn from received ones (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "encrypt": {
          "description": "Encrypt new messages by default when every recipient has a key\n(default false).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "openpgp-key": {
          "description": "Own OpenPGP key: primary key fingerprint (40 or 64 hex digits).",
          "type": [
            "string",
            "null"
          ]
        },
        "prefer-encrypt": {
          "description": "Autocrypt prefer-encrypt (default nopreference).",
          "anyOf": [
            {
              "$ref": "#/$defs/PreferEncryptSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "protect-headers": {
          "description": "Hide the subject of encrypted mail on the wire (default true).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "sign": {
          "description": "Sign new messages by default (default false).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "smime-cert": {
          "description": "Own S/MIME certificate: SHA-256 fingerprint (64 hex digits).",
          "type": [
            "string",
            "null"
          ]
        },
        "technology": {
          "description": "Preferred technology (default auto: what every recipient supports,\nOpenPGP when both work).",
          "anyOf": [
            {
              "$ref": "#/$defs/TechnologySchema"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DavSourceSchema": {
      "description": "`caldav \"<name>\"` / `carddav \"<name>\"` `name=… account=… url=… refresh=… enabled=… { auth … }`.",
      "type": "object",
      "properties": {
        "account": {
          "description": "The mail account whose login this server uses (and whose email\ndomain finds it when `url` is missing).",
          "type": [
            "string",
            "null"
          ]
        },
        "auth": {
          "description": "Login (default: the account's incoming-server login; required\nwithout `account`, with a `username`). Secret default:\n`keychain:nail/pim/<name>/password`.",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "description": "`#false` stops syncing without removing the data (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "name": {
          "description": "Display name (default: the server name).",
          "type": [
            "string",
            "null"
          ]
        },
        "refresh": {
          "description": "Poll interval in minutes, 5 to 10080 (default 15).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 10080,
          "minimum": 5
        },
        "url": {
          "description": "Server URL, https: (http: only for localhost). Required without\n`account`; default: discovered from the account's email domain.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ExchangeEngineSchema": {
      "description": "Which Exchange protocol an account speaks.",
      "oneOf": [
        {
          "description": "Microsoft Graph, for Exchange Online / Microsoft 365 (default).",
          "type": "string",
          "const": "graph"
        },
        {
          "description": "Exchange Web Services, for Exchange Server on-premises.",
          "type": "string",
          "const": "ews"
        }
      ]
    },
    "ExchangeSchema": {
      "description": "`exchange engine=… host=… port=… tls=… url=… poll-interval=…\nmax-poll-interval=… streaming=… server-rules=…`.",
      "type": "object",
      "properties": {
        "auth": {
          "description": "How to log in: Graph `auth \"oauth2\" provider=\"microsoft\"`; EWS also\n`auth \"windows\"` or `auth \"password\"` (Basic over TLS).",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine": {
          "description": "graph (default) or ews.",
          "anyOf": [
            {
              "$ref": "#/$defs/ExchangeEngineSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "description": "Host (default graph.microsoft.com for Graph; EWS: the Exchange\nserver, or the host of `url`).",
          "type": [
            "string",
            "null"
          ]
        },
        "max-poll-interval": {
          "description": "Longest seconds between change polls when nothing changes\n(default 300).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 86400,
          "minimum": 10
        },
        "poll-interval": {
          "description": "Shortest seconds between change polls (default 30).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 86400,
          "minimum": 10
        },
        "port": {
          "description": "Port (default 443).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 65535,
          "minimum": 1
        },
        "server-rules": {
          "description": "Place Nail rules as Exchange inbox rules where possible (default\n`#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "streaming": {
          "description": "EWS only: push through streaming notifications (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "tls": {
          "description": "Transport security (default implicit; plaintext only for localhost\ntest servers; no starttls).",
          "anyOf": [
            {
              "$ref": "#/$defs/TlsSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "description": "EWS only: the endpoint Autodiscover found (default\nhttps://<host>/EWS/Exchange.asmx).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "FolderRuleSchema": {
      "description": "One folder rule.",
      "type": "object",
      "properties": {
        "bodies": {
          "description": "What to download (not applied yet).",
          "anyOf": [
            {
              "$ref": "#/$defs/BodiesSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "days": {
          "description": "Days, with bodies=\"recent\" (not applied yet).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 36500,
          "minimum": 1
        },
        "enabled": {
          "description": "Synchronize the folder at all (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "idle": {
          "description": "Watch with IDLE (default: inbox only).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "path": {
          "description": "Full server path (or use `role`).",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Special-use role (or use `path`).",
          "anyOf": [
            {
              "$ref": "#/$defs/RoleSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "GmailSchema": {
      "description": "`gmail host=… port=… tls=… poll-interval=… max-poll-interval=…`\n(every property optional).",
      "type": "object",
      "properties": {
        "auth": {
          "description": "How to log in: `auth \"oauth2\" provider=\"google\"`.",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "description": "API host (default gmail.googleapis.com).",
          "type": [
            "string",
            "null"
          ]
        },
        "max-poll-interval": {
          "description": "Longest seconds between history polls when nothing changes\n(default 300).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 86400,
          "minimum": 10
        },
        "poll-interval": {
          "description": "Shortest seconds between history polls (default 30).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 86400,
          "minimum": 10
        },
        "port": {
          "description": "Port (default 443).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 65535,
          "minimum": 1
        },
        "tls": {
          "description": "Transport security (default implicit; plaintext only for localhost\ntest servers).",
          "anyOf": [
            {
              "$ref": "#/$defs/TlsSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "IdentityRuleSchema": {
      "description": "`identity-rule \"<pattern>\" identity=…`.",
      "type": "object",
      "properties": {
        "identity": {
          "description": "The identity id to use.",
          "type": "string"
        }
      },
      "required": [
        "identity"
      ]
    },
    "IdentitySchema": {
      "description": "`identity \"<address>\" id=… name=… reply-to=… composer=… posting=… send-as=… sender=… { bcc …; signature …; mail-style …; crypto … }`.",
      "type": "object",
      "properties": {
        "bcc": {
          "description": "`bcc \"<address>\" …`: always-Bcc addresses.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "composer": {
          "description": "Composer mode for new messages.",
          "anyOf": [
            {
              "$ref": "#/$defs/ComposerSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "crypto": {
          "description": "`crypto …`: end-to-end encryption and signing defaults.",
          "anyOf": [
            {
              "$ref": "#/$defs/CryptoSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "description": "The sender address (the node's argument).",
          "type": "string"
        },
        "id": {
          "description": "Stable id when the same address is used twice (default: the address).",
          "type": [
            "string",
            "null"
          ]
        },
        "mail-style": {
          "description": "`mail-style css=… code-theme=…`: stylesheet and code theme of HTML /\nMarkdown mail.",
          "anyOf": [
            {
              "$ref": "#/$defs/MailStyleSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "Display name.",
          "type": [
            "string",
            "null"
          ]
        },
        "posting": {
          "description": "Quote placement in replies (default bottom).",
          "anyOf": [
            {
              "$ref": "#/$defs/PostingSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply-to": {
          "description": "Reply-To address.",
          "type": [
            "string",
            "null"
          ]
        },
        "send-as": {
          "description": "Send for another mailbox (a shared / delegate Exchange mailbox whose\naddress is the identity's): \"send-as\" or \"on-behalf\".",
          "anyOf": [
            {
              "$ref": "#/$defs/SendAsSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "sender": {
          "description": "With send-as=\"on-behalf\": the user's own address for `Sender`\n(default: the account's address).",
          "type": [
            "string",
            "null"
          ]
        },
        "signature": {
          "description": "`signature \"<text>\" html=… markdown=…`.",
          "anyOf": [
            {
              "$ref": "#/$defs/SignatureSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "email"
      ]
    },
    "ImapSchema": {
      "description": "`imap host=… port=… tls=… poll-interval=… compress=… max-connections=…`.",
      "type": "object",
      "properties": {
        "auth": {
          "description": "How to log in (default: password, user name = account email).",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "compress": {
          "description": "Use COMPRESS=DEFLATE when offered (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "host": {
          "description": "Host name or IP address.",
          "type": "string"
        },
        "max-connections": {
          "description": "Maximum simultaneous connections (default 4).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 16,
          "minimum": 1
        },
        "poll-interval": {
          "description": "Seconds between polls of folders without IDLE (default 300).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 86400,
          "minimum": 30
        },
        "port": {
          "description": "Port (default 993 with implicit TLS, else 143).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 65535,
          "minimum": 1
        },
        "tls": {
          "description": "Transport security (default implicit).",
          "anyOf": [
            {
              "$ref": "#/$defs/TlsSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "host"
      ]
    },
    "MailStyleSchema": {
      "description": "`mail-style css=… code-theme=…`.",
      "type": "object",
      "properties": {
        "code-theme": {
          "description": "Code-highlighting theme of Markdown code blocks, e.g. `InspiredGitHub`.",
          "type": [
            "string",
            "null"
          ]
        },
        "css": {
          "description": "CSS inlined into outgoing HTML (default: the built-in stylesheet).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MappedFolderSchema": {
      "description": "`folder account=… path=…` inside `map`.",
      "type": "object",
      "properties": {
        "account": {
          "description": "A member account.",
          "type": "string"
        },
        "path": {
          "description": "Full server path in that account.",
          "type": "string"
        }
      },
      "required": [
        "account",
        "path"
      ]
    },
    "OAuthProviderSchema": {
      "description": "`oauth-provider \"<id>\" client-id=… client-secret=… auth-url=… token-url=…`.",
      "type": "object",
      "properties": {
        "auth-url": {
          "description": "Authorization endpoint (required unless built in).",
          "type": [
            "string",
            "null"
          ]
        },
        "client-id": {
          "description": "The registered client id.",
          "type": "string"
        },
        "client-secret": {
          "description": "Keychain reference of the client secret, if the provider issued one.",
          "anyOf": [
            {
              "$ref": "#/$defs/SecretRefSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "scopes": {
          "description": "`scopes \"<scope>\" …`: scopes to request instead of the mail defaults.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "token-url": {
          "description": "Token endpoint (required unless built in).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "client-id"
      ]
    },
    "Pop3Schema": {
      "description": "`pop3 host=… port=… tls=… poll-interval=… leave-on-server=…\ndelete-after-days=… delete-when-deleted-locally=…`.",
      "type": "object",
      "properties": {
        "auth": {
          "description": "How to log in.",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "delete-after-days": {
          "description": "Delete from the server this many days after download.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 36500,
          "minimum": 1
        },
        "delete-when-deleted-locally": {
          "description": "Delete from the server when deleted locally (default `#false`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "host": {
          "description": "Host name or IP address.",
          "type": "string"
        },
        "leave-on-server": {
          "description": "Keep messages on the server (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "poll-interval": {
          "description": "Seconds between downloads (default 600).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 86400,
          "minimum": 30
        },
        "port": {
          "description": "Port (default 995 with implicit TLS, else 110).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 65535,
          "minimum": 1
        },
        "tls": {
          "description": "Transport security (default implicit).",
          "anyOf": [
            {
              "$ref": "#/$defs/TlsSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "host"
      ]
    },
    "PostingSchema": {
      "description": "Quote placement in replies.",
      "oneOf": [
        {
          "description": "New text above the quote.",
          "type": "string",
          "const": "top"
        },
        {
          "description": "New text below the quote.",
          "type": "string",
          "const": "bottom"
        }
      ]
    },
    "PreferEncryptSchema": {
      "description": "Autocrypt prefer-encrypt.",
      "oneOf": [
        {
          "description": "Encrypt by default when both sides say so.",
          "type": "string",
          "const": "mutual"
        },
        {
          "description": "No preference.",
          "type": "string",
          "const": "nopreference"
        }
      ]
    },
    "RoleSchema": {
      "description": "A special-use role.",
      "oneOf": [
        {
          "description": "Inbox.",
          "type": "string",
          "const": "inbox"
        },
        {
          "description": "Sent.",
          "type": "string",
          "const": "sent"
        },
        {
          "description": "Drafts.",
          "type": "string",
          "const": "drafts"
        },
        {
          "description": "Archive.",
          "type": "string",
          "const": "archive"
        },
        {
          "description": "Junk.",
          "type": "string",
          "const": "junk"
        },
        {
          "description": "Trash.",
          "type": "string",
          "const": "trash"
        }
      ]
    },
    "SecretRefSchema": {
      "description": "A keychain reference: `keychain:<service>/<name>`.",
      "type": "string",
      "pattern": "^keychain:[^/\\s]+/\\S+$"
    },
    "SendAsSchema": {
      "description": "How an identity sends for another mailbox.",
      "oneOf": [
        {
          "description": "The mail is from the mailbox alone (Send As permission).",
          "type": "string",
          "const": "send-as"
        },
        {
          "description": "From the mailbox, on behalf of the user (Send on Behalf permission).",
          "type": "string",
          "const": "on-behalf"
        }
      ]
    },
    "SieveSchema": {
      "description": "`sieve host=… port=… tls=… script=… enabled=…` (every property optional).",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "`#false` keeps the settings but runs every rule in Nail (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "host": {
          "description": "Host name or IP address (default: the IMAP host).",
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "description": "Port (default 4190).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 65535,
          "minimum": 1
        },
        "script": {
          "description": "Name of Nail's script on the server (default \"nail\").",
          "type": [
            "string",
            "null"
          ]
        },
        "tls": {
          "description": "Transport security (default starttls).",
          "anyOf": [
            {
              "$ref": "#/$defs/TlsSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SignatureSchema": {
      "description": "A signature.",
      "type": "object",
      "properties": {
        "html": {
          "description": "HTML variant.",
          "type": [
            "string",
            "null"
          ]
        },
        "markdown": {
          "description": "Markdown variant.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "Plain text (the node's argument).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SmtpSchema": {
      "description": "`smtp host=… port=… tls=… dsn=…`.",
      "type": "object",
      "properties": {
        "auth": {
          "description": "How to log in.",
          "anyOf": [
            {
              "$ref": "#/$defs/AuthSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "dsn": {
          "description": "Request delivery status notifications for failures.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "host": {
          "description": "Host name or IP address.",
          "type": "string"
        },
        "port": {
          "description": "Port (default 465 with implicit TLS, else 587).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 65535,
          "minimum": 1
        },
        "tls": {
          "description": "Transport security (default implicit).",
          "anyOf": [
            {
              "$ref": "#/$defs/TlsSchema"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "host"
      ]
    },
    "SyncSchema": {
      "description": "`sync bodies=… days=… { folder … }`.",
      "type": "object",
      "properties": {
        "bodies": {
          "description": "Default for all folders (default full). Not applied yet: whole\nmessages are always downloaded.",
          "anyOf": [
            {
              "$ref": "#/$defs/BodiesSchema"
            },
            {
              "type": "null"
            }
          ]
        },
        "days": {
          "description": "Days, with bodies=\"recent\" (not applied yet).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 36500,
          "minimum": 1
        },
        "folder": {
          "description": "`folder path=…|role=… bodies=… days=… enabled=… idle=…` rules, later\nones override earlier ones.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FolderRuleSchema"
          }
        }
      }
    },
    "TechnologySchema": {
      "description": "End-to-end technology.",
      "oneOf": [
        {
          "description": "Whatever every recipient supports.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "OpenPGP.",
          "type": "string",
          "const": "openpgp"
        },
        {
          "description": "S/MIME.",
          "type": "string",
          "const": "smime"
        }
      ]
    },
    "TlsSchema": {
      "description": "Transport security.",
      "oneOf": [
        {
          "description": "TLS from the start (default).",
          "type": "string",
          "const": "implicit"
        },
        {
          "description": "STARTTLS / STLS upgrade.",
          "type": "string",
          "const": "starttls"
        },
        {
          "description": "No TLS (local test servers only).",
          "type": "string",
          "const": "plaintext"
        }
      ]
    },
    "VirtualAccountSchema": {
      "description": "`virtual-account \"<name>\" name=… default-identity=… merge-roles=… { … }`.",
      "type": "object",
      "properties": {
        "default-identity": {
          "description": "Identity id for new messages (default: the first member's default).",
          "type": [
            "string",
            "null"
          ]
        },
        "identity-rule": {
          "description": "`identity-rule \"<pattern>\" identity=…`: identity by recipient domain.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/IdentityRuleSchema"
          }
        },
        "map": {
          "description": "`map \"<folder name>\" { folder account=… path=… }`: merged folders.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/MappedFolderSchema"
            }
          }
        },
        "members": {
          "description": "`members \"<account>\" …`: the real accounts shown together.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "merge-roles": {
          "description": "Merge folders with the same role (default `#true`).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "name": {
          "description": "Display name (default: the name).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "members"
      ]
    }
  }
}

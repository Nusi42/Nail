// My paper theme.
theme "Paper" extends="frost" {
    tokens {
        // The accent I like.
        color "accent" "#3b5bdb" dark="#91a7ff" // blue
        radius "md" 6
    }

    modes {
        dark {
            color "bg" "#101113"
        }
    }

    part "folder-tree.item" {
        border-radius 4
    }
}

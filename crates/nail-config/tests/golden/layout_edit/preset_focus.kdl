// Changes made in Nail. See the layout reference in the user documentation.
layout "custom" extends="default" {
    breakpoint min-width=900 {
        window "mail" {
            stack id="panes" sizes="1fr auto auto" {
                stack id="reader" label="@layout.pane.message" sizes="auto 1fr" {
                    toolbar id="reader-toolbar" toolbar="reader"
                    // The conversation as cards, oldest first (P2): unread
                    // messages and the newest one open, older read ones one
                    // line each. An open card shows the message's signature /
                    // encryption and sender check badges, warnings about
                    // deceptive links and risky attachments, the blocked
                    // remote images, the junk verdict, a body that is not
                    // stored yet and the message itself (`card=` chooses and
                    // orders them).
                    thread-view id="thread" mode="cards"
                }
                stack id="sidebar" label="@layout.pane.folders" sizes="1fr auto auto auto" hidden=#true {
                    // New message, Favorites (the Outbox only while mail waits
                    // there), one section per account (with its colour), smart
                    // folders once you saved a search.
                    folder-tree id="folders" show-unread=#true \
                        sections="favorites accounts smart-folders" \
                        favorites="all-inboxes flagged snoozed drafts outbox" \
                        collapsible=#true account-colors=#true
                    // Gmail accounts: labels as views (nothing for other accounts).
                    label-list id="gmail-labels"
                    // Exchange accounts: shared / delegate mailboxes and the
                    // master category list (nothing for other accounts).
                    exchange-mailboxes id="exchange-mailboxes"
                    exchange-categories id="exchange-categories"
                }
                stack id="list-pane" label="@layout.pane.messages" sizes="auto auto auto auto 1fr" hidden=#true {
                    // Search, the folder's title with counts, filter chips.
                    list-header id="list-header"
                    // While automatic replies (out of office) of an Exchange
                    // account are on: a banner with Turn off / Edit.
                    automatic-replies-banner id="automatic-replies"
                    // Gmail inbox categories (nothing for other accounts).
                    category-tabs id="gmail-categories"
                    // Exchange Focused Inbox tabs (nothing for other accounts).
                    focused-tabs id="exchange-focused"
                    // One row per conversation (P2): the newest sender, the
                    // number of messages when there are several, the date.
                    message-list id="list" page-size=100 threads="collapsed" {
                        row "{from.name}  {count | if-many}  {date | relative}"
                        row "{subject}"
                        row "{preview}"
                    }
                }
            }
        }
    }
    breakpoint max-width=899 {
        window "mail" {
            tabs id="panes" active=1 {
                stack id="sidebar" label="@layout.pane.folders" sizes="1fr auto auto auto" {
                    folder-tree id="folders" show-unread=#true \
                        sections="favorites accounts smart-folders" \
                        favorites="all-inboxes flagged snoozed drafts outbox" \
                        collapsible=#true account-colors=#true
                    label-list id="gmail-labels"
                    exchange-mailboxes id="exchange-mailboxes"
                    exchange-categories id="exchange-categories"
                }
                stack id="list-pane" label="@layout.pane.messages" sizes="auto auto auto auto 1fr" {
                    list-header id="list-header" counts=#false
                    automatic-replies-banner id="automatic-replies"
                    category-tabs id="gmail-categories"
                    focused-tabs id="exchange-focused"
                    message-list id="list" page-size=100 threads="collapsed" {
                        row "{from.name}  {count | if-many}  {date | relative}"
                        row "{subject}"
                    }
                }
                stack id="reader" label="@layout.pane.message" sizes="auto 1fr" {
                    toolbar id="reader-toolbar" toolbar="reader"
                    thread-view id="thread" mode="cards"
                }
            }
        }
    }
}

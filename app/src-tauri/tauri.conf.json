{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nail",
  "version": "0.1.0",
  "identifier": "app.nail.desktop",
  "mainBinaryName": "Nail",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w ui",
    "beforeBuildCommand": "npm run build -w ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Nail",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: nail-proxy: http://nail-proxy.localhost; font-src 'self' data: nail-proxy: http://nail-proxy.localhost; style-src 'self' 'unsafe-inline'; frame-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nail",
    "copyright": "Copyright (c) Nail contributors",
    "category": "Productivity",
    "resources": {
      "../../ui/dist/": "ui/"
    },
    "shortDescription": "Mail, calendar and contacts",
    "longDescription": "Nail is an email and PIM client with a Rust core, a customizable UI and MCP access to your data.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "template": "windows/nsis/installer.nsi",
        "installerHooks": "windows/nsis/hooks.nsh",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
